def _node_toll(argv):
    flags, pos = parse_flags(argv, {"set-share": "value"})
    if pos:
        raise UsageError("`mad node toll` takes flags, not arguments.")
    ndir = _node_dir()
    share_path = os.path.join(ndir, "toll_share.json")
    if flags.get("set-share") is not None:
        try:
            pct = float(flags["set-share"])
        except ValueError:
            raise UsageError("--set-share takes a number, 0 to 100.")
        if not 0 <= pct <= 100:
            raise UsageError("--set-share takes a number, 0 to 100.")
        cfg = {"operator_share_pct": pct,
               "mad_wallet": NODE_MAD_WALLET,
               "set_by": "founder",
               "note": "the founder sets the operator share; the "
                       "node never sets it for itself"}
        with open(share_path, "w") as f:
            json.dump(cfg, f, indent=2)
        voice("Operator share set to %g%% of each 1c verdict toll — "
              "MAD keeps the rest. The split applies to every "
              "verdict the door serves from now on." % pct)
        return EXIT_OK
    served, collected = _node_toll_totals()
    try:
        with open(share_path) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {"operator_share_pct": None,
               "mad_wallet": NODE_MAD_WALLET}
    pct = cfg.get("operator_share_pct")
    data = {"served_verdicts": served,
            "toll_collected_usdc": collected,
            "operator_share_pct": pct,
            "operator_share_usdc": (round(collected * pct / 100, 4)
                                    if pct is not None else None),
            "mad_wallet": NODE_MAD_WALLET,
            "note": "operator share is UNSET until the founder "
                    "sets it — the node earns through the toll "
                    "split, never through a license"}
    line = ("%d verdicts served, %.2f USDC collected. Operator "
            "share: %s." % (
                served, collected,
                "%g%% (%.2f USDC)" % (pct,
                                      round(collected * pct / 100, 4))
                if pct is not None else "UNSET — the founder sets it"))
    show(data, line)
    return EXIT_OK


def cmd_tail(argv):
    flags, pos = parse_flags(argv, {"limit": "value"})
    if pos:
        raise UsageError(
            "`mad tail` takes no arguments. --limit trims it, that's "
            "all. The tail is the tail.")
    try:
        limit = int(flags.get("limit") or 10)
    except ValueError:
        raise UsageError("--limit takes a number. Obviously.")
    ndir = _node_dir()
    out = {"node": "mad-node-robinhood", "blocks": [], "tasks": []}
    try:
        with open(os.path.join(ndir, "verdicts-robinhood.jsonl")) as f:
            lines = [l for l in f if l.strip()]
    except OSError:
        lines = []
    for line in lines[-limit:]:
        try:
            r = json.loads(line)
        except ValueError:
            continue
        out["blocks"].append(
            {"block": r.get("block"), "verdict": r.get("verdict"),
             "txs": r.get("tx_count"),
             "findings": len(r.get("findings") or [])})
    try:
        with open(os.path.join(ndir, "task-grades-robinhood.jsonl")) as f:
            tlines = [l for l in f if l.strip()]
    except OSError:
        tlines = []
    for line in tlines[-limit:]:
        try:
            r = json.loads(line)
        except ValueError:
            continue
        out["tasks"].append(
            {"tx": (r.get("task") or {}).get("tx_hash"),
             "block": (r.get("task") or {}).get("block"),
             "verdict": r.get("verdict")})
    if not out["blocks"] and not out["tasks"]:
        voice("Nothing graded yet. `mad node start` and the tail "
              "fills itself, block by block.")
        return EXIT_OK
    voice("The node's tail - newest verdicts first, %d blocks on "
          "file. Read them before you pay anyone." % len(lines))
    show(out)
    return EXIT_OK


