JSON_MODE = False

# The conversation's ear: while the REPL is answering one turn,
# REPLY_BUF collects MAD's voice lines so the turn can be remembered.
# None outside a turn - voice() behaves exactly as before then.
REPLY_BUF = None


def voice(line):
    """MAD speaks. In --json mode the voice goes to stderr so stdout
    stays parseable; the facts never lose their voice. The MAD:
    prefix wears the flame red from the avatar."""
    if REPLY_BUF is not None:
        REPLY_BUF.append(line)
    stream = sys.stderr if JSON_MODE else sys.stdout
    prefix = "MAD: "
    if _color_on(stream):
        prefix = "\x1b[1;38;5;%dmMAD:\x1b[0m " % THEME["flame"]
    print(prefix + line, file=stream)


