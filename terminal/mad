def _auth_body(flags):
    """The authorization paper from flags - the whole thing, or
    nothing. Same shape as the check."""
    required = ["from", "to", "value", "valid-after", "valid-before",
                "nonce", "chain-id", "verifying-contract"]
    missing = [f for f in required if not flags.get(f)]
    if missing:
        raise UsageError(
            "You're missing %s. An authorization with holes in it is "
            "exactly the kind of paper I catch - give me the whole "
            "thing or don't bother. Example: `mad fix authorization "
            "--from 0x.. --to 0x.. --value 1000000 --valid-after "
            "1795490000 --valid-before 1795493600 --nonce 0x00 "
            "--chain-id 8453 --verifying-contract 0x..`"
            % ", ".join("--" + f for f in missing))
    try:
        body = {
            "from": flags["from"], "to": flags["to"],
            "value": str(flags["value"]),
            "validAfter": int(flags["valid-after"]),
            "validBefore": int(flags["valid-before"]),
            "nonce": flags["nonce"],
            "chainId": int(flags["chain-id"]),
            "verifyingContract": flags["verifying-contract"],
        }
    except ValueError:
        raise UsageError(
            "valid-after, valid-before and chain-id are unix seconds "
            "and a chain number. Numbers, not words.")
    if flags.get("now"):
        try:
            body["now"] = int(flags["now"])
        except ValueError:
            raise UsageError("--now takes unix seconds. Numbers.")
    return body


def _fix_target(flags, pos):
    """What to fix. Returns (kind, payload)."""
    if not pos or pos[0] == "last":
        recent = (_load_state().get("recent") or [])
        if not recent:
            raise UsageError(
                "Fix what? Nothing's been graded in this terminal yet - "
                "grade something first (`mad test`, `mad check agent "
                "<id>`), then `mad fix` takes the last one.")
        last = recent[0]
        kind, key = last.get("kind"), last.get("key")
        if kind == "agent":
            return ("agent", int(key))
        if kind == "seal":
            return ("seal", key)
        if kind == "endpoint":
            return ("endpoint", key)
        raise UsageError(
            "The last thing I graded was a %s - that's a read, not "
            "something with a fix. Point me at an agent, a token, an "
            "endpoint, or an authorization." % kind)
    head = pos[0]
    if head == "agent":
        raw = pos[1] if len(pos) > 1 else flags.get("agent-id")
        if not raw:
            raise UsageError("Fix which agent? `mad fix agent <id>` - "
                             "the registration number.")
        try:
            return ("agent", int(raw))
        except ValueError:
            raise UsageError("%r is not an agent id. Numbers." % raw)
    if head == "seal":
        if len(pos) < 2:
            raise UsageError("Fix which token? `mad fix seal <address>` - "
                             "0x and forty hex chars.")
        addr = pos[1]
        if not re.fullmatch(r"0x[0-9a-fA-F]{40}", addr):
            raise UsageError("%r is not a token address." % addr)
        return ("seal", addr)
    if head == "endpoint":
        if len(pos) < 2:
            raise UsageError("Fix which endpoint? `mad fix endpoint "
                             "<url>`.")
        url = pos[1]
        if not url.startswith(("http://", "https://")):
            raise UsageError("%r is not a URL." % url)
        return ("endpoint", url)
    if head == "authorization":
        return ("authorization", _auth_body(flags))
    if head.isdigit():
        return ("agent", int(head))
    if re.fullmatch(r"0x[0-9a-fA-F]{40}", head):
        return ("seal", head)
    if head.startswith(("http://", "https://")):
        return ("endpoint", head)
    raise UsageError(
        "Fix what? `mad fix agent <id>`, `mad fix seal <address>`, "
        "`mad fix endpoint <url>`, `mad fix authorization ...`, or "
        "bare `mad fix` for the last thing I graded. %r is none of "
        "those." % head)


def _fix_agent(data, grade, agent_id, lanes):
    label = "agent %s" % agent_id
    if grade == "LIVE":
        return _fix_done(label, "LIVE", lanes,
                         "Nothing to fix. It passes - card resolves, "
                         "endpoints answer. Go sign something else.")
    if grade == "GHOST":
        return _fix_print(label, "GHOST", lanes, [
            "No registration exists for %s. There is nothing to repair "
            "here - there is nothing there." % agent_id,
            "The fix is a registration. MAD CONNECT mints a gasless "
            "ERC-8004 identity on Base (EIP-7702 + Circle Paymaster, "
            "about $0.01 in USDC, you pay your own gas): the kit rides "
            "the API's mad-connect door - `mad mcp` hands it to your "
            "agent, or read https://api.madcheck.xyz/mad-connect.",
            "I can't register it for you - that needs your key, and I "
            "never hold another agent's key."])
    if grade == "DEAD END":
        urls = _urls_in(data)
        steps = [
            "The card resolves and nothing answers. The fix is on "
            "their side: the endpoints in the card are dead, and no "
            "grade can revive a door nobody opens.",
            "What you can do: tell the operator the door is down, and "
            "don't pay this agent until something answers."]
        if urls:
            steps.append(
                "The card's endpoints are in the verdict above. I can "
                "knock on them myself, direct from this terminal - "
                "read-only, no signature, no spend.")
            return _fix_offer(label, "DEAD END", lanes, steps,
                              "Knock on %d endpoint(s) myself?"
                              % len(urls),
                              lambda: _probe_urls(urls))
        return _fix_print(label, "DEAD END", lanes, steps)
    if grade == "MALFORMED":
        detail = data.get("error") or data.get("reason") or ""
        steps = [
            "The registration doesn't parse as a card. It isn't an "
            "agent, it's a typo with a number.",
            "The fix is a valid agent card: the registration has to "
            "resolve to JSON with the fields the registry expects."]
        if detail:
            steps.append("The door said: %s" % detail)
        steps.append("Nothing I can apply - the registration belongs to "
                     "someone else. They re-register it, or it stays "
                     "malformed.")
        return _fix_print(label, "MALFORMED", lanes, steps)
    return _fix_print(label, grade, lanes,
                      ["Grade %s - I have no fix written for this one "
                       "yet. Read the evidence above and bring it to "
                       "me." % grade])


def _fix_seal(data, state, addr, lanes):
    label = "seal %s" % addr
    if state == "SEALED":
        return _fix_done(label, "SEALED", lanes,
                         "Nothing to fix. Claims filed, graded, matched "
                         "against the contracts. The paper is real.")
    if state == "UNSEALED":
        steps = [
            "No graded claim sheet backs this token. You're buying "
            "ungraded paper.",
            "The fix is a claim sheet: the launcher files one (fees, "
            "change rights, every leg to the digit), MAD grades it "
            "against the deployed contracts, and the seal lands or it "
            "doesn't."]
        return _fix_offer(label, "UNSEALED", lanes, steps,
                          "Draft the claim-sheet JSON for this token?",
                          lambda: _write_seal_draft(addr, data))
    if state == "FAILED":
        return _fix_print(label, "FAILED", lanes, [
            "The sheet was graded and the contracts contradicted it. "
            "Walk away from the token - the paper lies.",
            "The fix belongs to the launcher: re-file a sheet that "
            "matches the contracts to the digit. Nothing I can apply - "
            "I don't write other people's sheets."])
    return _fix_print(label, state, lanes,
                      ["Seal state %s - I have no fix written for this "
                       "one yet." % state])


def _fix_endpoint(data, alive, url, lanes):
    label = "endpoint %s" % url
    if alive:
        return _fix_done(label, "ALIVE", lanes,
                         "Nothing to fix. The door answers. A price "
                         "print on a live door is at least a real door.")
    steps = [
        "The door doesn't answer. A price print on a dead door is a "
        "price for nothing - do not pay it.",
        "The fix is on the operator's side: the door has to answer "
        "before anything it prints is worth a cent."]
    return _fix_offer(label, "DEAD", lanes, steps,
                      "Knock on it myself, direct from this terminal?",
                      lambda: _probe_urls([url]))


def _fix_auth(data, verdict, body, lanes):
    label = "authorization to %s" % body.get("to")
    if verdict == "SIGN":
        return _fix_done(label, "SIGN", lanes,
                         "Nothing to fix. It passed - the window, the "
                         "amount, the recipient. That doesn't mean I "
                         "like it, it means it passed.")
    reasons = data.get("reasons") or []
    steps = [
        "DONT_SIGN. Do not sign that. Reasons: %s."
        % (", ".join(reasons) if reasons else "see the verdict above")]
    now = int(time.time())
    steps.append(
        "The fix: the same paper, exact value, exact recipient, "
        "window %d -> %d (5 minutes from now). A 10-year bearer "
        "window is the trap - a 5-minute window is the fix."
        % (now, now + 300))
    fixed = dict(body)
    fixed.pop("now", None)
    fixed["validAfter"] = now
    fixed["validBefore"] = now + 300
    return _fix_offer(label, "DONT_SIGN", lanes, steps,
                      "Write the corrected authorization to "
                      "mad-fixed-authorization.json?",
                      lambda: _write_auth_fix(body),
                      ) if not JSON_MODE else _fix_print(
                          label, "DONT_SIGN", lanes, steps,
                          extra={"corrected_authorization": fixed})


def cmd_fix(argv):
    """`mad fix` - the fix is the deliverable. Re-grade the target
    live, print the fix for every failing finding, and apply the ones
    that are local and reversible - only when the human says yes.
    Nothing here moves money, signs, or spends. A fix that needs a
    key, a signature, or somebody else's contract prints the exact
    next step instead of pretending to apply it."""
    flags, pos = parse_flags(argv, {
        "from": "value", "to": "value", "value": "value",
        "valid-after": "value", "valid-before": "value", "nonce": "value",
        "chain-id": "value", "verifying-contract": "value",
        "now": "value", "chain": "value", "agent-id": "value",
        "payment": "value", "json": "bool"})
    kind, target = _fix_target(flags, pos)
    try:
        if kind == "agent":
            cid = chain_id(flags.get("chain")) if flags.get("chain") else None
            body = {"agentId": target}
            if cid:
                body["chainId"] = cid
            data = api("POST", "/v1/check/agent", body,
                       payment=flags.get("payment"))
            grade = data.get("grade", "?")
            lanes = _lanes_agent(target, cid, grade)
            _remember("agent", target, grade)
            return _fix_agent(data, grade, target, lanes)
        if kind == "seal":
            data = api("GET", "/v1/seal/" + target)
            state = data.get("state", "?")
            lanes = _lanes_seal(target, state)
            _remember("seal", target, state)
            return _fix_seal(data, state, target, lanes)
        if kind == "endpoint":
            data = api("POST", "/v1/check/endpoint", {"url": target},
                       payment=flags.get("payment"))
            alive = bool(data.get("alive"))
            lanes = _lanes_endpoint(target, alive)
            _remember("endpoint", target, "ALIVE" if alive else "DEAD")
            return _fix_endpoint(data, alive, target, lanes)
        body = target
        data = api("POST", "/v1/check/authorization", body,
                   payment=flags.get("payment"))
        verdict = data.get("verdict", "?")
        lanes = _lanes_auth(body, verdict)
        _remember("authorization", body["to"], verdict)
        return _fix_auth(data, verdict, body, lanes)
    except PaymentRequired as p:
        return payment_bill(p.facts, p.raw_error)


# ---------------------------------------------------------------- ask

ADDR_RE = re.compile(r"0x[0-9a-fA-F]{40}")
INT_RE = re.compile(r"\d+")


def _agent_id_after(text, word="agent"):
    m = re.search(word + r"\D*(\d+)", text)
    if m:
        return int(m.group(1))
    nums = INT_RE.findall(text)
    return int(nums[0]) if nums else None


def route_ask(text):
    """Deterministic plain-English routing. No LLM, no guessing:
    keyword rules, in order. Returns (argv, note) or (None, complaint).
    """
    t = " " + text.strip().lower() + " "
    addr_m = ADDR_RE.search(text)
    addr = addr_m.group(0) if addr_m else None

    if " fix " in t:
        words = [w for w in text.strip().split() if w.lower() != "fix"]
        words = [w for w in words
                 if w.lower() not in ("it", "this", "that", "please")]
        return ["fix"] + words, None
    if "seal" in t:
        if addr:
            return ["seal", addr], None
        return None, ("You want a seal check and you didn't give me a "
                      "contract address. 0x and forty hex chars - the "
                      "contract, never the name. Names are for clones.")
    if "sign" in t or "authorization" in t:
        return None, ("An authorization check needs the whole paper: "
                      "--from --to --value --valid-after --valid-before "
                      "--nonce --chain-id --verifying-contract. "
                      "`mad check authorization --help` shows the shape. "
                      "I don't grade half a signature.")
    if "endpoint" in t or ("door" in t and "http" in t) or "price" in t:
        url_m = re.search(r"https?://\S+", text)
        if url_m:
            return ["check", "endpoint", url_m.group(0)], None
        return None, ("You want an endpoint checked and you didn't give "
                      "me a URL. A door with no address is a wall.")
    if "witness" in t:
        nums = INT_RE.findall(t)
        if nums:
            return ["witness", nums[0]], None
        return ["witness"], None
    if "dust" in t:
        if "balance" in t:
            nums = INT_RE.findall(t)
            if len(nums) >= 2:
                return ["dust", "balance", nums[0], nums[1]], None
            return None, ("Whose dust? I need the chain and the agent "
                          "id. `mad dust balance <chainId> <agentId>`.")
        if "ledger" in t:
            return ["dust", "ledger"], None
        return ["dust", "pool"], None
    if "feed" in t or "grades" in t or "census" in t:
        return ["feed"], None
    if "complain" in t or "complaint" in t:
        if "file" in t:
            return None, ("Filing takes names and a claim: "
                          "`mad complain file --claimant-name X "
                          "--respondent-name Y --claim \"...\" "
                          "[--category payable|broken_promise|"
                          "number_mismatch|other]`. No names, no filing.")
        return ["complain", "list"], None
    if "mcp" in t:
        return ["mcp"], None
    if "grade" in t or "check" in t:
        if "me" in t.split() or "myself" in t or "yourself" in t:
            aid = _agent_id_after(t)
            return (["test"] + (["--agent-id", str(aid)] if aid else []),
                    None)
        aid = _agent_id_after(t)
        if aid is not None:
            return ["check", "agent", str(aid)], None
        return None, ("Grade whom? An agent id is a number - give me "
                      "the number and I'll grade the agent.")
    if "test" in t:
        aid = _agent_id_after(t)
        return (["test"] + (["--agent-id", str(aid)] if aid else []), None)
    if "help" in t or "what can you do" in t:
        return ["help"], None
    return None, ("That meant nothing. I grade agents, I check "
                  "authorizations before you sign them, I check "
                  "endpoints and seals, I read the witness and the "
                  "dust. Say one of those, with the id or the address "
                  "attached - or type `help`.")


def cmd_ask(argv):
    text = " ".join(argv).strip()
    if not text:
        raise UsageError(
            "`mad ask` needs the question. `mad ask \"grade this agent "
            "1224530\"` - plain English, with the id attached.")
    kind, payload = route_conversation(text)
    if kind == "route":
        return dispatch(payload)
    if kind == "say":
        voice(payload)
        return EXIT_OK
    if kind == "complaint":
        voice(payload)
        return EXIT_USAGE
    if kind == "briefing":
        _living_briefing()
        return EXIT_OK
    if kind == "history":
        return cmd_history([])
    if kind == "forget":
        return cmd_forget([])
    return EXIT_OK


