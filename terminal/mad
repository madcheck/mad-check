def _urls_in(obj, limit=5):
    """Any http(s) strings inside a verdict payload - the card's
    endpoints, usually."""
    found = []

    def walk(o):
        if len(found) >= limit:
            return
        if isinstance(o, str):
            for m in re.finditer(r"https?://[^\s\"'<>]+", o):
                if m.group(0) not in found:
                    found.append(m.group(0))
        elif isinstance(o, dict):
            for v in o.values():
                walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)

    walk(obj)
    return found


def _fix_print(kind_label, verdict, lanes, steps, applied=None, file=None,
               extra=None):
    """The fix, in both modes. Human: voice + THE FIX block + lanes.
    --json: one JSON object (stdout parseable, voice on stderr)."""
    if JSON_MODE:
        fix = {"steps": steps, "applied": bool(applied), "file": file}
        if extra:
            fix.update(extra)
        data = {"target": kind_label, "verdict": verdict, "fix": fix,
                "lanes": lanes}
        show(data, "Fix for %s: %s." % (kind_label, verdict))
        return EXIT_OK
    voice("Re-graded %s: %s." % (kind_label, verdict))
    print()
    print("THE FIX:")
    for s in steps:
        print("  " + s)
    if applied and file:
        print("  Applied: %s" % file)
    print()
    print("LANES - three routes, one answer:")
    for l in lanes:
        suffix = "" if l["status"] == "ok" else " [%s]" % l["status"]
        print("  %d. %s: %s%s" % (l["lane"], l["name"], l["detail"],
                                  suffix))
    return EXIT_OK


def _fix_done(kind_label, verdict, lanes, note):
    return _fix_print(kind_label, verdict, lanes, [note])


def _fix_offer(kind_label, verdict, lanes, steps, question, applier):
    """A fix that can be applied locally, reversibly - only when the
    human says yes. In --json mode nothing is applied: the offer is
    printed with applied=false and the note needs-confirmation."""
    if JSON_MODE:
        steps = steps + ["Offer: %s (not applied in --json mode - "
                                "re-run without --json and say yes.)"
                         % question]
        return _fix_print(kind_label, verdict, lanes, steps,
                          applied=False)
    _fix_print(kind_label, verdict, lanes, steps)
    if _confirm(question):
        applied, note = applier()
        if applied:
            voice("Applied. %s" % note)
        else:
            voice("Tried and couldn't: %s" % note)
        return EXIT_OK
    voice("Not applied. Your call - the fix is printed above whenever "
          "you want it.")
    return EXIT_OK


def _probe_urls(urls):
    bits = []
    for u in urls:
        st, detail = _direct_probe(u)
        bits.append("%s: %s" % (u, detail))
    return True, " | ".join(bits)


def _write_auth_fix(body):
    """The corrected authorization, as a file. NOT signed - the human
    signs it themself. Same recipient, same exact value, window
    now -> now+300. The 10-year bearer window is the trap; a 5-minute
    window is the fix."""
    now = int(time.time())
    fixed = dict(body)
    fixed.pop("now", None)
    fixed["validAfter"] = now
    fixed["validBefore"] = now + 300
    obj = {"corrected_authorization": fixed,
           "note": "NOT signed - sign this yourself, then re-run the "
                   "check with the new window. The window is 300 "
                   "seconds; the value and recipient are unchanged, "
                   "exact.",
           "drafted_by": "mad-terminal fix"}
    path = os.path.join(os.getcwd(), "mad-fixed-authorization.json")
    with open(path, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=2)
    return True, ("corrected authorization written to %s - sign it "
                  "yourself, I never sign." % path)


