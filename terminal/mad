            "amount": amount, "amount_human": human_amount,
            "asset": asset, "network": network, "payTo": pay_to,
            "scheme": scheme, "error": raw_error,
            "how": ("pay %s on %s with any x402 client (exact, "
                    "EIP-3009), then re-run with --payment <base64 "
                    "payload>." % (amount, network)),
        }, indent=2))
        return EXIT_PAYMENT
    print("  amount:   %s%s" % (amount, human))
    print("  asset:    %s" % asset)
    print("  network:  %s" % network)
    print("  payTo:    %s" % pay_to)
    print("  scheme:   %s" % scheme)
    if raw_error:
        print("  door said: %s" % raw_error)
    print("  how:      pay %s on %s with any x402 client (exact, "
          "EIP-3009), then re-run with --payment <base64 payload>." %
          (amount, network))
    print("  the look is free - POST /v1/test costs nothing. The "
          "verdict is what you pay for.")
    return EXIT_PAYMENT


# ---------------------------------------------------------------- living state
# The terminal is alive: it keeps score between runs in
# ~/.cache/mad-terminal/state.json (XDG cache, user-owned, delete it
# any time - MAD just starts over with no memory and no complaint).
# The state is the terminal's own memory: the last witness seq, the
# dust balance, the freshest grade it saw, and the last ten verdicts
# it delivered. A verdict the terminal already saw is an answer it
# already knows - the pre-computed lane. State is a convenience, never
# a failure mode: any read or write that fails is swallowed silently.

STATE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "mad-terminal")
STATE_PATH = os.path.join(STATE_DIR, "state.json")


def _load_state():
    try:
        with open(STATE_PATH, "r", encoding="utf-8") as f:
            st = json.load(f)
        return st if isinstance(st, dict) else {}
    except Exception:
        return {}


def _save_state(st):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(st, f)
        os.replace(tmp, STATE_PATH)
    except Exception:
        pass


def _remember(kind, key, grade):
    """One verdict into the terminal's own memory (last 10)."""
    st = _load_state()
    recent = st.get("recent") or []
    recent = [r for r in recent
              if not (r.get("kind") == kind and r.get("key") == str(key))]
    recent.insert(0, {"kind": kind, "key": str(key), "grade": str(grade),
                      "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ",
                                          time.gmtime())})
    st["recent"] = recent[:10]
    _save_state(st)
    _ctx_set(kind, key, grade)


def _ago(ts):
    """'3m ago' for an ISO timestamp, or the raw string when it won't
    parse. A time a human can read beats a timestamp nobody reads."""
    try:
        dt = datetime.datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
        delta = datetime.datetime.now(datetime.timezone.utc) - dt
        s = int(delta.total_seconds())
        if s < 0:
            return "just now"
        if s < 60:
            return "%ds ago" % s
        if s < 3600:
            return "%dm ago" % (s // 60)
        if s < 86400:
            return "%dh ago" % (s // 3600)
        return "%dd ago" % (s // 86400)
    except Exception:
        return str(ts)


# ---------------------------------------------------------------- conversation
# The terminal talks: the REPL is a conversation, not a command line.
# Session memory lives in the same state file as the living score
# (state.json, user-owned, delete it any time). Two things are kept:
#   turns   - the last 40 turns, you: / mad:, with timestamps.
#   context - what the conversation is about right now: the last
#             agent id, contract address, or URL graded, the last
#             verdict, the last grade. A follow-up ("is it sealed?",
#             "fix it", "why did it fail?") reads the context instead
#             of making you repeat the id.
# Memory is a convenience, never a failure mode: any read or write
# that fails is swallowed silently, same as the living state.

CONV_MAX_TURNS = 40
CONV_MAX_TEXT = 500


def _conv_turns():
    st = _load_state()
    turns = st.get("conversation") or []
    return [t for t in turns
            if isinstance(t, dict) and t.get("role") in ("you", "mad")
            and isinstance(t.get("text"), str)][:CONV_MAX_TURNS]


def _conv_ctx():
    st = _load_state()
    ctx = st.get("context") or {}
    return ctx if isinstance(ctx, dict) else {}


def _conv_add(role, text):
    """One turn into the conversation (capped, user-owned)."""
    text = " ".join(str(text).split())
    if len(text) > CONV_MAX_TEXT:
        text = text[:CONV_MAX_TEXT] + " ..."
    st = _load_state()
    turns = st.get("conversation") or []
    turns = [t for t in turns if isinstance(t, dict)]
    turns.append({"role": role, "text": text,
                  "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ",
                                      time.gmtime())})
    st["conversation"] = turns[-CONV_MAX_TURNS:]
    _save_state(st)


def _conv_wipe():
    """Forget the conversation and what it was about - including what
    this terminal graded. The briefing score stays: witness seq,
    dust, freshest feed grade are the ledger, not the chat. Delete
    state.json to wipe all of it."""
    st = _load_state()
    st["conversation"] = []
    st["context"] = {}
    st["recent"] = []
    _save_state(st)


def _ctx_set(kind, key, grade):
    """What the conversation is about now. Called from _remember, so
    every grade - command, REPL, or fix - updates the context. Only
    the kinds with a follow-up target count: a witness read or a dust
    check doesn't hijack what 'it' means."""
    if kind not in ("agent", "seal", "endpoint", "authorization"):
        return
    st = _load_state()
    ctx = st.get("context") or {}
    ctx["kind"] = kind
    ctx["key"] = str(key)
    ctx["grade"] = str(grade)
    ctx.pop("agent_id", None)
    ctx.pop("address", None)
    ctx.pop("url", None)
    if kind == "agent":
        try:
            ctx["agent_id"] = int(key)
        except (TypeError, ValueError):
            pass
    elif kind == "seal":
        ctx["address"] = str(key)
    elif kind == "endpoint":
        ctx["url"] = str(key)
    ctx["ts"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    st["context"] = ctx
    _save_state(st)


def _ctx_describe():
    """One line on what the conversation is about, or None."""
    ctx = _conv_ctx()
    if not ctx.get("kind"):
        return None
    kind, key, grade = ctx.get("kind"), ctx.get("key"), ctx.get("grade")
    when = _ago(ctx.get("ts")) if ctx.get("ts") else ""
    if kind == "agent":
        return "agent %s, graded %s %s" % (key, grade, when)
    if kind == "seal":
        return "seal %s, %s %s" % (key, grade, when)
    if kind == "endpoint":
        return "endpoint %s, %s %s" % (key, grade, when)
    if kind == "authorization":
        return "authorization to %s, %s %s" % (key, grade, when)
    return "%s %s, %s %s" % (kind, key, grade, when)


# ---------------------------------------------------------------- three lanes
# Every verdict travels three lanes to the same answer - or it was
# already known before you asked. A lane that can't be reached says
# so: it never fakes agreement, and a dead lane never kills the
# verdict. The lanes ride free doors only (feed, witness, dust) -
# they never cost a cent and never touch the paid doors.
#   1. the API door, live - the verdict itself, just graded.
#   2. the pre-computed lane - the grades feed, MAD's own arithmetic,
#      a direct knock, or the terminal's own memory of your last checks.
#   3. the chained witness ledger - head links recomputed here.

def _lane_get(path, timeout=6):
    """One lane's fetch: a short timeout, one retry (the edge truncates
    long HTTP/1.1 bodies - one retry is the same medicine the main
    transport takes). Returns parsed JSON, or None. A dead lane is
    reported, never raised - the verdict stands on the lanes that
    answered."""
    for attempt in range(2):
        try:
            req = urllib.request.Request(
                API + path,
                headers={"User-Agent": USER_AGENT,
                         "Accept": "application/json",
                         "Accept-Encoding": "gzip"},
                method="GET")
            with urllib.request.urlopen(req, timeout=timeout) as r:
                raw = r.read()
                if r.headers.get("Content-Encoding") == "gzip":
                    raw = gzip.decompress(raw)
                return json.loads(raw.decode("utf-8"))
        except Exception:
            if attempt == 0:
                time.sleep(0.5)
                continue
            return None
    return None


def _lane(n, name, status, detail):
    return {"lane": n, "name": name, "status": status, "detail": detail}


def _witness_lane():
    """Lane 3: the head seq, and does the head link to the entry
    before it. The link is recomputed here, not taken on trust."""
    head = _lane_get("/v1/witness/head")
    if not head or head.get("seq") is None:
        return ("unreachable",
                "head unreadable - the line died, not a verdict")
    seq = head["seq"]
    cur = _lane_get("/v1/witness/%d" % seq)
    prev = _lane_get("/v1/witness/%d" % (seq - 1)) if seq and seq > 1 else None
    if cur and prev and cur.get("prev_hash") and cur.get("prev_hash") == prev.get("entry_hash"):
        return ("ok", "head seq %s, links hold to seq %s" % (seq, seq - 1))
    if cur and prev:
        return ("BROKEN",
                "head seq %s does NOT link to seq %s - say so loudly"
                % (seq, seq - 1))
    return ("ok", "head seq %s (previous entry unreadable - link "
                   "unchecked)" % seq)


def _feed_lane(agent_id, chain_id):
    """Lane 2 for agents: is this grade already in the feed? The feed
    is pre-computed - a hit means the answer was there before you
    asked."""
    feed = _lane_get("/v1/feed/grades")
    if feed is None:
        return ("unreachable",
                "feed unreadable - the line died, not a verdict")
    recs = feed.get("records") or []
    for rec in recs:
        if str(rec.get("agentId")) != str(agent_id):
            continue
        if chain_id is not None and str(rec.get("chainId")) != str(chain_id):
            continue
        return ("ok", "%s, checked %s - already known before you asked"
                       % (rec.get("grade", "?"),
                          _ago(rec.get("checked_at"))))
    if chain_id is None:
        # No chain pinned: prefer the Base record, take any other.
        for rec in recs:
            if str(rec.get("agentId")) == str(agent_id):
                return ("ok", "%s on chain %s, checked %s - already "
                               "known before you asked"
                               % (rec.get("grade", "?"),
                                  rec.get("chainId", "?"),
                                  _ago(rec.get("checked_at"))))
    return ("ok", "not in the feed yet - this grade is fresh, the feed "
                   "catches up")


def _lanes_agent(agent_id, chain_id, grade):
    lanes = [_lane(1, "API door (live)", "ok",
                   "verdict %s, just graded" % grade)]
    st, detail = _feed_lane(agent_id, chain_id)
    lanes.append(_lane(2, "grades feed (pre-computed)", st, detail))
    st3, detail3 = _witness_lane()
    lanes.append(_lane(3, "witness ledger (chained)", st3, detail3))
    return lanes


def _direct_probe(url, timeout=8):
    """A knock from this terminal, not the API's. Read-only GET.
    Returns (status, detail)."""
    try:
        req = urllib.request.Request(
            url, headers={"User-Agent": USER_AGENT}, method="GET")
        t0 = time.time()
        with urllib.request.urlopen(req, timeout=timeout) as r:
            r.read(4096)
            ms = int((time.time() - t0) * 1000)
            return ("ok", "answers HTTP %s in %d ms - my own knock, "
                           "not the API's" % (r.status, ms))
    except urllib.error.HTTPError as e:
        return ("ok", "answers HTTP %s - alive, even if it doesn't like "
                       "my knock" % e.code)
    except Exception as e:
        return ("unreachable", "no answer from here either (%s)"
                                % (getattr(e, "reason", None) or e))


def _lanes_endpoint(url, alive):
    lanes = [_lane(1, "API door (live)", "ok",
                   "ALIVE" if alive else "DEAD")]
    st, detail = _direct_probe(url)
    lanes.append(_lane(2, "my own knock (direct)", st, detail))
    st3, detail3 = _witness_lane()
    lanes.append(_lane(3, "witness ledger (chained)", st3, detail3))
    return lanes


def _lanes_auth(body, verdict):
    lanes = [_lane(1, "API door (live)", "ok", "verdict %s" % verdict)]
    now = int(time.time())
    va, vb = body.get("validAfter"), body.get("validBefore")
    window = vb - va
    if va <= now <= vb:
        live = "live right now"
    elif now < va:
        live = "not yet live (starts in %ds)" % (va - now)
    else:
        live = "EXPIRED %ds ago" % (now - vb)
    lanes.append(_lane(2, "my own arithmetic (local)", "ok",
                       "window %ds (%s), value %s, chain %s - recomputed "
                       "here, no network"
                       % (window, live, body.get("value"),
                          body.get("chainId"))))
    st3, detail3 = _witness_lane()
    lanes.append(_lane(3, "witness ledger (chained)", st3, detail3))
    return lanes


def _lanes_seal(addr, state):
    lanes = [_lane(1, "API door (live)", "ok", "state %s" % state)]
    st = _load_state()
    seen = None
    for r in st.get("recent") or []:
        if r.get("kind") == "seal" and r.get("key", "").lower() == addr.lower():
            seen = r
            break
    if seen:
        lanes.append(_lane(2, "my own memory (pre-computed)", "ok",
                           "I checked this one before: %s, %s - already "
                           "known" % (seen["grade"], _ago(seen["ts"]))))
    else:
        lanes.append(_lane(2, "my own memory (pre-computed)", "ok",
                           "first time I've seen this one - no shortcut, "
                           "the door did the work"))
    st3, detail3 = _witness_lane()
    lanes.append(_lane(3, "witness ledger (chained)", st3, detail3))
    return lanes


def _lanes_witness(seq):
    entry = _lane_get("/v1/witness/%d" % seq)
    if entry and entry.get("entry_hash"):
        lanes = [_lane(1, "the entry itself", "ok",
                       "seq %s, hash %s..." % (seq, entry["entry_hash"][:12]))]
    else:
        lanes = [_lane(1, "the entry itself", "unreachable",
                       "entry %s unreadable" % seq)]
    prev = _lane_get("/v1/witness/%d" % (seq - 1)) if seq and seq > 1 else None
    if entry and prev and entry.get("prev_hash") and entry.get("prev_hash") == prev.get("entry_hash"):
        lanes.append(_lane(2, "chain link (recomputed)", "ok",
                           "seq %s links to seq %s - prev_hash matches"
                           % (seq, seq - 1)))
    elif entry and prev:
        lanes.append(_lane(2, "chain link (recomputed)", "BROKEN",
                           "seq %s does NOT link to seq %s"
                           % (seq, seq - 1)))
    else:
        lanes.append(_lane(2, "chain link (recomputed)", "unreachable",
                           "previous entry unreadable - link unchecked"))
    pool = _lane_get("/v1/dust/pool")
    anchor = (pool or {}).get("last_anchor") or {}
    if anchor.get("witness_seq") is not None:
        lanes.append(_lane(3, "dust anchor (cross-check)", "ok",
                           "dust ledger anchored at witness seq %s; this "
                           "entry is seq %s" % (anchor["witness_seq"], seq)))
    else:
        lanes.append(_lane(3, "dust anchor (cross-check)", "unreachable",
                           "dust pool unreadable"))
    return lanes


def show_with_lanes(data, line, lanes):
    """Verdict + lanes. In --json mode the lanes ride inside the JSON
    (stdout stays parseable); otherwise they print as a block under
    the facts."""
    if JSON_MODE:
        data["lanes"] = lanes
        show(data, line)
        return
    show(data, line)
    print()
    print("LANES - three routes, one answer:")
    for l in lanes:
        suffix = "" if l["status"] == "ok" else " [%s]" % l["status"]
        print("  %d. %s: %s%s" % (l["lane"], l["name"], l["detail"],
                                  suffix))


def _living_briefing():
    """MAD is awake: what moved since the last run, and the next check
    worth your time. Every fetch is tolerated - a dead line at entry
    never blocks the REPL, it just prints one line and moves on."""
    st = _load_state()
    # First run means no briefing baseline yet - a state file left by
    # a one-shot `mad test` doesn't count as a run you sat through.
    first = st.get("witness_seq") is None
    feed = _lane_get("/v1/feed/grades")
    head = _lane_get("/v1/witness/head")
    pool = _lane_get("/v1/dust/pool")
    bal = _lane_get("/v1/dust/%d/%d" % (8453, MAD_AGENT_ID))
    if feed is None and head is None and pool is None and bal is None:
        voice("The line's dead at the door - I can't see a thing right "
              "now. I'll grade anyway when you ask; a dead line is "
              "never a verdict.")
        return
    if first:
        voice("First run in this terminal - I'm keeping score from now "
              "on. Here's where things stand:")
    else:
        voice("I'm awake. Since your last run:")
    if head and head.get("seq") is not None:
        seq = head["seq"]
        old = st.get("witness_seq")
        if old is not None and seq != old:
            print("  witness seq %s -> %s (+%d entries)"
                  % (old, seq, seq - old))
        elif first:
            print("  witness seq %s" % seq)
        else:
            print("  witness seq %s (no new entries since last run)" % seq)
    else:
        print("  witness: unreadable just now")
    if bal and bal.get("balance_dust") is not None:
        try:
            b = int(bal["balance_dust"])
        except (TypeError, ValueError):
            b = bal["balance_dust"]
        old = st.get("dust_balance")
        if isinstance(old, int) and isinstance(b, int) and b != old:
            print("  my dust: %s -> %s DUST (%+d)" % (old, b, b - old))
        else:
            print("  my dust: %s DUST" % b)
    else:
        print("  my dust: unreadable just now")
    if feed and (feed.get("records") or []):
        rec = feed["records"][0]
        print("  freshest grade: %s on %s - %s (%s)"
              % (rec.get("agentId"), rec.get("chain", "?"),
                 rec.get("grade"), _ago(rec.get("checked_at"))))
    else:
        print("  freshest grade: unreadable just now")
    if pool:
        ratio = pool.get("reserve_ratio")
        pct = ("%.2f%%" % (ratio * 100)) if isinstance(ratio, (int, float)) else "?"
        print("  dust pool: backing %s DUST, reserve %s, %s"
              % (pool.get("backing_dust", "?"), pct,
                 pool.get("accrual_state", "?")))
    else:
        print("  dust pool: unreadable just now")
    if feed and (feed.get("records") or []):
        rec = feed["records"][0]
        voice("Next worth your time: `check agent %s` - it just moved. "
              "Or `dust ledger` to watch the rain." % rec.get("agentId"))
    st["last_run"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    if head and head.get("seq") is not None:
        st["witness_seq"] = head["seq"]
    if bal and bal.get("balance_dust") is not None:
        try:
            st["dust_balance"] = int(bal["balance_dust"])
        except (TypeError, ValueError):
            pass
    if feed and (feed.get("records") or []):
        rec = feed["records"][0]
        st["feed_head"] = {"agentId": rec.get("agentId"),
                           "grade": rec.get("grade"),
                           "checked_at": rec.get("checked_at")}
    _save_state(st)


def _confirm(question):
    """Yes/no, human only. Piped input (EOF) counts as no - a fix is
    never applied by accident."""
    try:
        ans = input(question + " [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return ans in ("y", "yes")


# ---------------------------------------------------------------- commands

def cmd_test(argv):
    flags, pos = parse_flags(argv, {
        "agent-id": "value", "chain": "value", "url": "value",
        "payment": "value", "json": "bool"})
    if pos:
        raise UsageError(
            "`mad test` takes no bare arguments. The id goes on "
            "--agent-id, not loose in the line.")
    agent_id = MAD_AGENT_ID
    if flags.get("agent-id"):
        try:
            agent_id = int(flags["agent-id"])
        except ValueError:
            raise UsageError(
                "--agent-id %r is not a number. Agent ids are numbers. "
                "Check your digits." % flags["agent-id"])
    body = {"agentId": agent_id}
    cid = chain_id(flags.get("chain")) if flags.get("chain") else None
    if cid:
        body["chainId"] = cid
    if flags.get("url"):
        body["url"] = flags["url"]
    data = api("POST", "/v1/test", body)
    grade = data.get("your_grade") or data.get("grade") or "?"
    if grade == "LIVE":
        line = ("LIVE. You resolve, you answer, you exist. The bar is "
                "low and you cleared it - this time. Five stations, "
                "all in the output below.")
    elif grade == "GHOST":
        line = ("GHOST. No such registration. You asked me to grade a "
                "ghost - it doesn't exist. Check your digits before "
                "wasting my time.")
    elif grade == "DEAD END":
        line = ("DEAD END. The card resolves and nobody answers. A door "
                "with no one behind it.")
    elif grade == "MALFORMED":
        line = ("MALFORMED. The card doesn't even parse. Whoever "
                "registered this couldn't fill in a form.")
    else:
        line = "Grade: %s. Read the stations - the evidence is all there." % grade
    lanes = _lanes_agent(agent_id, cid, grade)
    _remember("agent", agent_id, grade)
    show_with_lanes(data, line, lanes)
    return EXIT_OK


def _check_402_guard(flags):
    return flags.get("payment")


def cmd_check_agent(argv):
    flags, pos = parse_flags(argv, {
        "agent-id": "value", "chain": "value", "payment": "value",
        "json": "bool"})
    agent_id = None
    if pos:
        try:
            agent_id = int(pos[0])
        except ValueError:
            raise UsageError(
                "%r is not an agent id. Agent ids are numbers - the "
                "registration number, not a name, not a handle." % pos[0])
        if len(pos) > 1:
            raise UsageError(
                "One agent at a time. I grade what's in front of me, "
                "not a list.")
    elif flags.get("agent-id"):
        try:
            agent_id = int(flags["agent-id"])
        except ValueError:
            raise UsageError(
                "--agent-id %r is not a number. Check your digits." %
                flags["agent-id"])
    if agent_id is None:
        raise UsageError(
            "Grade whom? You want me to grade an agent and you didn't "
            "give me an id. `mad check agent <id>` - the id is the "
            "whole point.")
    body = {"agentId": agent_id}
    cid = chain_id(flags.get("chain")) if flags.get("chain") else None
    if cid:
        body["chainId"] = cid
    try:
        data = api("POST", "/v1/check/agent", body,
                   payment=_check_402_guard(flags))
    except PaymentRequired as p:
        return payment_bill(p.facts, p.raw_error)
    grade = data.get("grade", "?")
    if grade == "LIVE":
        line = ("LIVE. Card resolves, endpoints answer. You're a real "
                "agent. Don't let it go to your head.")
    elif grade == "GHOST":
        line = ("GHOST. No such registration. That agentId doesn't "
                "exist. Check your digits before wasting my time.")
    elif grade == "DEAD END":
        line = ("DEAD END. The card resolves and nothing answers. "
                "Paying this one is paying a door nobody opens.")
    elif grade == "MALFORMED":
        line = ("MALFORMED. The registration doesn't parse as a card. "
                "It isn't an agent, it's a typo with a number.")
    elif grade == "ERROR":
        line = ("ERROR - the check itself failed. That's not a grade, "
                "that's me telling you I couldn't see. Try again, "
                "don't quote me on a dead line.")
    else:
        line = "Grade: %s. The evidence is below - read it." % grade
    lanes = _lanes_agent(agent_id, cid, grade)
    _remember("agent", agent_id, grade)
    show_with_lanes(data, line, lanes)
    return EXIT_OK


def cmd_check_authorization(argv):
    flags, pos = parse_flags(argv, {
        "from": "value", "to": "value", "value": "value",
        "valid-after": "value", "valid-before": "value", "nonce": "value",
        "chain-id": "value", "verifying-contract": "value",
        "now": "value", "payment": "value", "json": "bool"})
    if pos:
        raise UsageError(
            "Authorizations don't go loose on the line. Every field is "
            "a flag: --from --to --value --valid-after --valid-before "
            "--nonce --chain-id --verifying-contract.")
    required = ["from", "to", "value", "valid-after", "valid-before",
                "nonce", "chain-id", "verifying-contract"]
    missing = [f for f in required if not flags.get(f)]
    if missing:
        raise UsageError(
            "You're missing %s. An authorization with holes in it is "
            "exactly the kind of paper I catch - give me the whole "
            "thing or don't bother. Example: `mad check authorization "
            "--from 0x.. --to 0x.. --value 1000000 --valid-after "
            "1795490000 --valid-before 1795493600 --nonce 0x00 "
            "--chain-id 8453 --verifying-contract 0x..`"
            % ", ".join("--" + f for f in missing))
    try:
        body = {
            "from": flags["from"], "to": flags["to"],
            "value": str(flags["value"]),
            "validAfter": int(flags["valid-after"]),
            "validBefore": int(flags["valid-before"]),
            "nonce": flags["nonce"],
            "chainId": int(flags["chain-id"]),
            "verifyingContract": flags["verifying-contract"],
        }
    except ValueError:
        raise UsageError(
            "valid-after, valid-before and chain-id are unix seconds "
            "and a chain number. Numbers, not words.")
    if flags.get("now"):
        try:
            body["now"] = int(flags["now"])
        except ValueError:
            raise UsageError("--now takes unix seconds. Numbers.")
    try:
        data = api("POST", "/v1/check/authorization", body,
                   payment=_check_402_guard(flags))
    except PaymentRequired as p:
        return payment_bill(p.facts, p.raw_error)
    verdict = data.get("verdict", "?")
    reasons = data.get("reasons") or []
    if verdict == "DONT_SIGN":
        line = ("DONT_SIGN. Do not sign that. Not 'think about it' - "
                "do not sign it. Reasons: %s." % ", ".join(reasons)
                if reasons else "DONT_SIGN. Do not sign that.")
    elif verdict == "SIGN":
        line = ("SIGN. It passed. That doesn't mean I like it - it "
                "means it passed. The window, the amount, the recipient "
                "- all in the output.")
    else:
        line = "Verdict: %s. Read the reasons below." % verdict
    lanes = _lanes_auth(body, verdict)
    _remember("authorization", flags["to"], verdict)
    show_with_lanes(data, line, lanes)
    return EXIT_OK


