        return EXIT_TRANSPORT
    ndir = _node_dir()
    path = os.path.join(ndir, "verdicts-robinhood.jsonl")
    if flags.get("verify"):
        bad = 0
        checked = 0
        try:
            with open(path) as f:
                for line in f:
                    if not line.strip():
                        continue
                    try:
                        rec = json.loads(line)
                    except ValueError:
                        continue
                    if not rec.get("signed"):
                        continue
                    checked += 1
                    if not tape.verify_signed_verdict(rec):
                        bad += 1
                        print("  BAD SIGNATURE block %s"
                              % rec.get("block"))
        except OSError:
            voice("No verdict ledger yet — nothing graded, nothing "
                  "to verify.")
            return EXIT_OK
        voice("%d signed verdicts checked, %d bad. %s" % (
            checked, bad,
            "Every signature verifies from the record alone."
            if not bad else "The bad ones are listed above."))
        return EXIT_OK if not bad else EXIT_API_ERROR
    key = _sign.load_operator_key()
    if not key:
        voice("No operator key configured — nothing to sign with. "
              "`mad node key` shows where it goes.")
        return EXIT_API_ERROR
    if flags.get("block"):
        block = int(flags["block"])
        changed = _node_sign_records(path, tape, key,
                                     block=block)
        voice("Signed %d record%s for block %d." % (
            changed, "s" if changed != 1 else "", block))
        return EXIT_OK
    if flags.get("backfill"):
        changed = _node_sign_records(path, tape, key)
        voice("Backfilled %d unsigned verdict%s. The verdict_hash "
              "never changes — it's computed over the unsigned "
              "fields — so the tape stays valid." % (
                  changed, "s" if changed != 1 else ""))
        return EXIT_OK
    raise UsageError("`mad node sign` needs --backfill, --block N, "
                     "or --verify.")


def _node_sign_records(path, tape, key, block=None):
    """Sign unsigned ledger records in place, atomically. Returns
    the count signed."""
    changed = 0
    tmp = path + ".tmp"
    try:
        with open(path) as f:
            lines = f.readlines()
    except OSError:
        return 0
    with open(tmp, "w") as out:
        for line in lines:
            if not line.strip():
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                out.write(line)
                continue
            if block is not None and rec.get("block") != block:
                out.write(line)
                continue
            if rec.get("signed"):
                out.write(line)
                continue
            rec = tape.sign_verdict(rec, key)
            changed += 1
            out.write(json.dumps(rec) + "\n")
    os.replace(tmp, path)
    return changed


def _node_anchor(argv):
    flags, pos = parse_flags(argv, {"block": "value"})
    if pos:
        raise UsageError("`mad node anchor` takes flags, not arguments.")
    _sign, tape = _node_modules()
    if _sign is None or tape is None:
        voice("Anchoring isn't in this install. Reinstall "
              "mad-terminal 0.1.6.")
        return EXIT_TRANSPORT
    ndir = _node_dir()
    base = _node_tasks_base()
    entries, chain_ok, _broken = tape.read_tape(ndir)
    if flags.get("block"):
        block = int(flags["block"])
        rec = None
        try:
            with open(os.path.join(ndir,
                                   "verdicts-robinhood.jsonl")) as f:
                for line in f:
                    if not line.strip():
                        continue
                    try:
                        r = json.loads(line)
                    except ValueError:
                        continue
                    if r.get("block") == block:
                        rec = r
        except OSError:
            rec = None
        if not rec:
            voice("No verdict for block %d in the ledger." % block)
            return EXIT_API_ERROR
        if not rec.get("signed"):
            key = _sign.load_operator_key()
            if not key:
                voice("Block %d is unsigned and no operator key is "
                      "configured — `mad node key` shows where it "
                      "goes." % block)
                return EXIT_API_ERROR
            _node_sign_records(
                os.path.join(ndir, "verdicts-robinhood.jsonl"),
                tape, key, block=block)
            rec = tape.sign_verdict(rec, key)
        receipt = {"kind": "mad-node-verdict",
                   "node": "mad-node-robinhood",
                   "block": block,
                   "block_hash": rec.get("block_hash"),
                   "verdict": rec.get("verdict"),
                   "verdict_hash": rec.get("verdict_hash"),
                   "signature": rec.get("signature"),
                   "signer": rec.get("signer")}
    else:
        if not entries:
            voice("The tape is empty — nothing to anchor.")
            return EXIT_OK
        head = entries[-1]
        receipt = {"kind": "mad-node-tape-head",
                   "node": "mad-node-robinhood",
                   "head_seq": head.get("seq"),
                   "head_entry_hash": head.get("entry_hash"),
                   "chain_ok": chain_ok,
                   "entries": len(entries)}
    try:
        filed = _tasks_http("POST", "/v1/witness",
                            {"receipt": receipt}, timeout=15)
        seq = filed.get("witness_seq") or filed.get("seq")
        if seq is not None and entries:
            try:
                tape.tape_anchor(ndir, seq, entries[-1].get("entry_hash"),
                                 entries[-1].get("seq"))
            except Exception:  # noqa: BLE001
                pass
        voice("Anchored in the witness ledger — seq %s. The receipt "
              "verifies from the signature alone; the anchor is the "
              "public timestamp." % seq)
        show({"receipt": receipt, "witness_seq": seq}, "")
        return EXIT_OK
    except ApiError as e:
        if e.status == 402:
            voice("The door at %s wants 1c for the witness — the "
                  "node never pays. The receipt below is signed and "
                  "verifiable as it stands; file it from the local "
                  "API (MAD_TASKS_API=http://127.0.0.1:8402) or hand "
                  "it to MAD." % base)
            show({"receipt": receipt}, "")
            return EXIT_OK
        raise
    except TransportError:
        voice("The witness door is unreachable at %s. The receipt "
              "below is signed and verifiable as it stands — file "
              "it when the door is back." % base)
        show({"receipt": receipt}, "")
        return EXIT_OK


