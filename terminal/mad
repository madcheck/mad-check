def chain_id(s):
    if s is None:
        return None
    if str(s).lower() in CHAINS:
        return CHAINS[str(s).lower()]
    try:
        n = int(s)
    except (TypeError, ValueError):
        raise UsageError(
            "Chain %r is not a chain I know. base (8453) or robinhood "
            "(4663). Pick one." % (s,))
    if n not in (8453, 4663):
        raise UsageError(
            "Chain %d is not one I grade on. Base 8453 or Robinhood "
            "4663. That's the list." % n)
    return n


def parse_flags(argv, spec):
    """Minimal flag parser. spec: {name: ('value'|'bool'|'multi')}.

    Returns (flags, positionals). Unknown flags are a usage error -
    I don't guess at flags."""
    flags = {}
    pos = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            pos.extend(argv[i + 1:])
            break
        if a.startswith("--"):
            if "=" in a:
                name, val = a[2:].split("=", 1)
                kind = spec.get(name)
                if kind is None:
                    known = ", ".join("--" + k for k in sorted(spec))
                    raise UsageError(
                        "--%s is not a flag I know. This command "
                        "takes: %s. Run `mad help` before inventing "
                        "options." % (name, known))
                if kind == "bool":
                    flags[name] = val.lower() not in ("0", "false", "no")
                elif kind == "multi":
                    flags.setdefault(name, []).append(val)
                else:
                    flags[name] = val
            else:
                name = a[2:]
                kind = spec.get(name)
                if kind is None:
                    known = ", ".join("--" + k for k in sorted(spec))
                    raise UsageError(
                        "--%s is not a flag I know. This command "
                        "takes: %s. Run `mad help` before inventing "
                        "options." % (name, known))
                if kind == "bool":
                    flags[name] = True
                else:
                    if i + 1 >= len(argv):
                        raise UsageError(
                            "--%s needs a value. A flag with nothing "
                            "after it is just noise." % name)
                    i += 1
                    if kind == "multi":
                        flags.setdefault(name, []).append(argv[i])
                    else:
                        flags[name] = argv[i]
        else:
            pos.append(a)
        i += 1
    return flags, pos


