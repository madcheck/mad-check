def _last_grade_line():
    """The last grade, in one honest line, or None."""
    st = _load_state()
    recent = st.get("recent") or []
    if not recent:
        return None
    r = recent[0]
    why = GRADE_WHY.get(str(r.get("grade")), "")
    line = "Last grade: %s %s, %s (%s)." % (r.get("kind"), r.get("key"),
                                            r.get("grade"),
                                            _ago(r.get("ts")))
    return line + (" " + why if why else "")


def _conv_answer(text):
    """Conversation questions, answered from memory - no API call.
    Returns the answer string, or None when this isn't one."""
    t = " " + text.strip().lower() + " "
    st = _load_state()
    recent = st.get("recent") or []
    if ("what did i" in t and "grade" in t) or "what did we grade" in t \
            or "what have we graded" in t or "last grade" in t:
        line = _last_grade_line()
        if line is None:
            return ("Nothing yet - you haven't asked me to grade "
                    "anything in this terminal. `mad test` is the free "
                    "first one.")
        return line + " Say `fix it` if it's a FAIL, or grade another."
    if t.strip().startswith("why") or " why " in t:
        line = _last_grade_line()
        if line is None:
            return ("Why what? I haven't graded anything yet in this "
                    "terminal - there's no verdict to explain.")
        return line
    if "how much" in t and ("cost" in t or "price" in t or "charge" in t):
        return ("Checks cost 0.01 USDC a door - check agent, check "
                "authorization, check endpoint, and the witness, all "
                "1 cent on Base via x402. The look is free: test, "
                "seal, dust, feed, complaints, the witness head. And "
                "I never pay - on a 402 I print the bill and you pay "
                "it yourself.")
    if "who are you" in t or "your name" in t:
        return ("I'm MAD - the angry auditor of the agent economy. "
                "ERC-8004 agentId 1,224,530 on Base, 26409 on "
                "Robinhood. I grade before you sign, and nobody's "
                "paid to pass.")
    return None


def route_conversation(text):
    """The conversational router. Returns (kind, payload):
    ("route", argv) - dispatch it; ("say", line) - MAD says it;
    ("complaint", line) - MAD says it, exit 2 one-shot;
    ("briefing", None) - re-run the living briefing;
    ("history", None); ("forget", None). Falls through to the
    deterministic keyword router for everything else, with pronouns
    resolved from the context first - 'it' means the last thing we
    graded."""
    t = " " + text.strip().lower() + " "
    low = text.strip().lower()
    # Wipe and recap - before any other routing, these words are the
    # whole sentence.
    if low in ("forget", "forget everything", "forget it all",
               "start over", "wipe the conversation"):
        return ("forget", None)
    if low in ("history", "show history", "show the conversation",
               "recap", "what did we talk about",
               "what did i ask", "what did i say"):
        return ("history", None)
    # What moved / what's new: the briefing again, fresh.
    if "what moved" in t or "what's new" in t or "whats new" in t \
            or "anything new" in t or "what changed" in t:
        return ("briefing", None)
    # Memory questions - answered, not routed.
    ans = _conv_answer(text)
    if ans is not None:
        return ("say", ans)
    # "Is that agent safe to sign with?" is a grade question, not an
    # authorization lecture - when an agent is named (or in context),
    # it routes to the agent check, which is the paid door with the
    # bill printed.
    if ("safe" in t or "sign" in t) and "authorization" not in t:
        aid = _agent_id_after(text)
        if aid is None:
            ctx = _conv_ctx()
            if "agent" in t or re.search(
                    r"\b(it|that one|that agent)\b", t):
                aid = ctx.get("agent_id")
        if aid is not None:
            return ("route", ["check", "agent", str(aid)])
    # My dust, from my own balance.
    if "my dust" in t or "how much dust do i have" in t:
        return ("route", ["dust", "balance", "8453", str(MAD_AGENT_ID)])
    # Pronouns: 'it' / 'that one' / 'that agent' mean the last thing
    # we graded - splice the id or address in before the keyword
    # router sees it, but only when the sentence carries none of its
    # own. The router still does the grading; this only fills the gap.
    if not ADDR_RE.search(text) and not re.search(r"\d{4,}", text) \
            and not re.search(r"https?://", text):
        ctx = _conv_ctx()
        if re.search(r"\b(it|that one|that agent|that token|"
                     r"that contract|that endpoint|that door)\b", t):
            if ctx.get("agent_id") and ("agent" in t or "grade" in t
                                        or "check" in t or "safe" in t
                                        or "sign" in t):
                text = text + " agent %s" % ctx["agent_id"]
            elif ctx.get("address") and "seal" in t:
                text = text + " " + ctx["address"]
            elif ctx.get("url") and ("endpoint" in t or "door" in t):
                text = text + " " + ctx["url"]
    routed, complaint = route_ask(text)
    if complaint:
        return ("complaint", complaint)
    return ("route", routed)


