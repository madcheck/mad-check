def _node_counts():
    """PASS/FLAG totals in the local ledger."""
    p = os.path.join(_node_dir(), "verdicts-robinhood.jsonl")
    n = 0
    verdicts = {"PASS": 0, "FLAG": 0}
    try:
        with open(p) as f:
            for line in f:
                if not line.strip():
                    continue
                n += 1
                try:
                    v = json.loads(line).get("verdict")
                except ValueError:
                    continue
                if v in verdicts:
                    verdicts[v] += 1
    except OSError:
        return 0, verdicts
    return n, verdicts


def cmd_node(argv):
    if not argv:
        raise UsageError(
            "`mad node` what? start, stop, status, license, task, "
            "serve, jobs, tape, drain, sign, anchor, key, or toll. "
            "`mad node start` runs it free - no license, no wallet "
            "needed. --wallet 0x... names the operator, --owner is "
            "MAD's own node, --test is the same free path.")
    sub = argv[0]
    rest = argv[1:]
    if sub not in NODE_SUBS:
        close = _closest(sub, NODE_SUBS)
        raise UsageError(
            "`node %s` isn't a thing. %sstart, stop, status, license, "
            "task, serve, jobs, tape, drain, sign, anchor, key, or "
            "toll - "
            "that's the whole node." % (
                sub, "Did you mean `mad node %s`? " % close
                if close else ""))
    if sub == "start":
        return _node_start(rest)
    if sub == "stop":
        return _node_stop(rest)
    if sub == "status":
        return _node_status(rest)
    if sub == "license":
        return _node_license(rest)
    if sub == "serve":
        return _node_serve(rest)
    if sub == "jobs":
        return _node_jobs(rest)
    if sub == "tape":
        return _node_tape(rest)
    if sub == "drain":
        return _node_drain(rest)
    if sub == "sign":
        return _node_sign(rest)
    if sub == "anchor":
        return _node_anchor(rest)
    if sub == "key":
        return _node_key(rest)
    if sub == "toll":
        return _node_toll(rest)
    return _node_task(rest)


