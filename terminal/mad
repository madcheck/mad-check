def _reply_summary(user_text):
    """What MAD said back, in one line for the memory. The voice lines
    captured during the turn, or the honest fallback when a command
    printed facts without speaking."""
    lines = [l for l in (REPLY_BUF or []) if l.strip()]
    if lines:
        return " ".join(lines[:3])
    return "I ran `%s` - the facts are printed above." % user_text


def cmd_talk(argv):
    global REPLY_BUF
    if argv:
        raise UsageError(
            "`mad talk` takes no arguments. It just starts - type, "
            "and I answer.")
    print_face("full")
    print(REPL_BANNER)
    _living_briefing()
    turns = _conv_turns()
    if turns:
        last_you = [t for t in turns if t["role"] == "you"]
        if last_you:
            voice("We talked before - last time you asked: \"%s\" "
                  "(%s). I remember." % (last_you[-1]["text"][:120],
                                         _ago(last_you[-1].get("ts"))))
    while True:
        try:
            line = input("mad> ")
        except EOFError:
            print()
            voice("Leaving already? The grades will still be here "
                  "when you come back. They always are.")
            return EXIT_OK
        except KeyboardInterrupt:
            print()
            voice("Ctrl-C doesn't grade anything. Type `quit` like "
                  "an adult.")
            continue
        text = line.strip()
        if not text:
            continue
        low = text.lower()
        if low in ("quit", "exit", "bye", "q"):
            voice("Done. Go sign nothing I haven't graded.")
            return EXIT_OK
        if low in ("help", "?"):
            cmd_help([])
            continue
        if low == "version":
            cmd_version([])
            continue
        if low in ("history", "hist"):
            cmd_history([])
            continue
        if low == "forget":
            cmd_forget([])
            continue
        # One turn: record what you said, capture what I say back.
        _conv_add("you", text)
        REPLY_BUF = []
        parts = text.split()
        if parts[0] == "mad":
            parts = parts[1:]
            if not parts:
                voice("You're already here - drop the `mad` and type "
                      "the command, like `test`.")
                _conv_add("mad", _reply_summary(text))
                REPLY_BUF = None
                continue
        if parts[0] in ("test", "check", "seal", "witness", "dust",
                        "feed", "complain", "mcp", "ask", "help", "fix",
                        "version", "history", "forget",
                        "--help", "-h", "--version", "-v"):
            try:
                dispatch(parts)
            except (UsageError, ApiError, TransportError) as e:
                _repl_error(e)
        else:
            try:
                cmd_ask([text])
            except (UsageError, ApiError, TransportError) as e:
                _repl_error(e)
        _conv_add("mad", _reply_summary(text))
        REPLY_BUF = None


def _repl_error(e):
    print_face("mini")
    if isinstance(e, UsageError):
        voice(str(e))
    elif isinstance(e, TransportError):
        voice("I couldn't reach the API. That's a network failure, "
              "not a verdict. Don't quote me on a dead line. (%s)" % e)
    elif isinstance(e, ApiError):
        voice("The API answered %s and it wasn't good news: %s. "
              "That's the door's fault, not yours - this time." %
              (e.status, (e.body or "")[:200]))
    else:
        voice("Something broke that wasn't your question. (%s)" % e)


