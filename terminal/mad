def dispatch(argv):
    global JSON_MODE
    if not argv:
        return cmd_talk([])
    # --help / --version work anywhere on the line, not only first:
    # `mad test --help` is how a human asks. A flag hiding as the
    # value of another flag (see _meta_flag) doesn't count.
    meta = _meta_flag(argv)
    if meta == "help":
        return cmd_help([])
    if meta == "version":
        return cmd_version([])
    cmd = argv[0]
    rest = argv[1:]
    if cmd == "check":
        if not rest:
            raise UsageError(
                "Check what? agent, authorization, or endpoint. "
                "`mad check agent <id>` is the usual one.")
        sub = rest[0]
        if sub == "agent":
            return cmd_check_agent(rest[1:])
        if sub == "authorization":
            return cmd_check_authorization(rest[1:])
        if sub == "endpoint":
            return cmd_check_endpoint(rest[1:])
        close = _closest(sub, CHECK_SUBS)
        raise UsageError(
            "`check %s` isn't a thing I check. %sagent, "
            "authorization, or endpoint. Pick one." % (
                sub, "Did you mean `mad check %s`? " % close
                if close else ""))
    if cmd == "dust" and rest:
        close = _closest(rest[0], DUST_SUBS)
        if close and rest[0] not in DUST_SUBS:
            raise UsageError(
                "`dust %s` isn't a thing. Did you mean "
                "`mad dust %s`? pool, ledger, or balance - that's the "
                "whole menu." % (rest[0], close))
    if cmd == "complain" and rest:
        close = _closest(rest[0], COMPLAIN_SUBS)
        if close and rest[0] not in COMPLAIN_SUBS:
            raise UsageError(
                "`complain %s` isn't a thing. Did you mean "
                "`mad complain %s`? file, list, or get - that's the "
                "desk." % (rest[0], close))
    fn = COMMANDS.get(cmd)
    if fn is None:
        if cmd == "--":
            # Bare `--`: the human meant `mad --help`. Show it.
            voice("`--` on its own means nothing - you wanted "
                  "`mad --help`. Here it is.")
            return cmd_help([])
        if cmd.startswith("-"):
            close = _closest(cmd, GLOBAL_FLAGS + ["--payment",
                                                  "--chain"])
            raise UsageError(
                "`%s` isn't a flag I know. %sRun `mad --help` - the "
                "flags that exist are on that page." % (
                    cmd, "Did you mean `%s`? " % close if close
                    else ""))
        close = _closest(cmd, COMMAND_NAMES)
        raise UsageError(
            "`%s` isn't a command. %sI do test, check, seal, witness, "
            "dust, feed, complain, ask, mcp, talk, version, help, fix, "
            "history, forget, node, tail. "
            "Or just type `mad` and talk to me." % (
                cmd, "Did you mean `mad %s`? " % close if close
                else ""))
    # --json anywhere after the command switches machine mode.
    if "--json" in rest:
        JSON_MODE = True
    return fn(rest)


def main(argv):
    global JSON_MODE
    try:
        if not argv:
            return cmd_talk([])
        # --json before the command (mad --json test) also counts.
        if "--json" in argv:
            JSON_MODE = True
            argv = [a for a in argv if a != "--json"]
            if not argv:
                return cmd_talk([])
        return dispatch(argv)
    except PaymentRequired as p:
        return payment_bill(p.facts, p.raw_error)
    except UsageError as e:
        print_face("mini")
        voice(str(e))
        return EXIT_USAGE
    except ApiError as e:
        print_face("mini")
        voice("The API answered %s and it wasn't good news: %s. "
              "That's the door's fault, not yours - this time." %
              (e.status, (e.body or "")[:200]))
        return EXIT_API_ERROR
    except TransportError as e:
        print_face("mini")
        voice("I couldn't reach the API. That's a network failure, "
              "not a verdict. Don't quote me on a dead line. (%s)" % e)
        return EXIT_TRANSPORT
    except BrokenPipeError:
        return EXIT_OK
    except KeyboardInterrupt:
        print()
        return EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
