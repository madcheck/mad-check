def _node_tape(argv):
    flags, pos = parse_flags(argv, {"limit": "value",
                                    "resolve": "bool"})
    if pos:
        raise UsageError("`mad node tape` takes flags, not arguments.")
    _sign, tape = _node_modules()
    if tape is None:
        voice("The tape isn't in this install. Reinstall "
              "mad-terminal 0.1.6.")
        return EXIT_TRANSPORT
    entries, chain_ok, broken = tape.read_tape(_node_dir())
    limit = int(flags.get("limit") or 20)
    if flags.get("resolve"):
        return _node_tape_resolve(entries)
    if not entries:
        voice("The tape is empty — no flags yet, no outcomes yet. "
              "The tape fills as the node catches things.")
        return EXIT_OK
    data = {"tape": "node-tape.jsonl", "entries": len(entries),
            "chain_ok": chain_ok, "broken_at_seq": broken,
            "records": entries[-limit:]}
    lines = ["The public tape — %d entries, chain %s%s:" % (
        len(entries), "OK" if chain_ok else "BROKEN",
        " (broken at seq %s)" % broken if broken else "")]
    for e in entries[-limit:]:
        kind = e.get("type")
        if kind == "flag":
            lines.append("  #%d FLAG block %s — %s" % (
                e.get("seq"), e.get("block"),
                ", ".join(e.get("checks") or [])))
        elif kind == "outcome":
            lines.append("  #%d OUTCOME — %s" % (
                e.get("seq"), e.get("outcome")))
        elif kind == "served":
            lines.append("  #%d SERVED block %s — %s USDC" % (
                e.get("seq"), e.get("block"),
                e.get("toll_usdc", "?")))
        elif kind == "task":
            lines.append("  #%d TASK %s — %s: %s" % (
                e.get("seq"), e.get("task_id"), e.get("target"),
                e.get("verdict")))
        elif kind == "anchor":
            lines.append("  #%d ANCHOR witness seq %s" % (
                e.get("seq"), e.get("witness_seq")))
        else:
            lines.append("  #%d %s" % (e.get("seq"), kind))
    show(data, "\n".join(lines))
    return EXIT_OK


def _node_tape_resolve(entries):
    """Follow up every open flag: what did the catch turn into?
    The tape entry holds the check NAMES; the full findings (with
    evidence) live in the verdict record for the flag's block, so
    the resolve reads the ledger, not the tape. C1: the newborn
    agent's census grade. C4: did the flood continue in the next
    10 blocks? C3: the cited source stands unless it retracts —
    the node says so plainly."""
    _sign, tape = _node_modules()
    ndir = _node_dir()
    resolved_hashes = {e.get("flag_entry_hash")
                       for e in entries if e.get("type") == "outcome"}
    flags = [e for e in entries if e.get("type") == "flag"
             and e.get("entry_hash") not in resolved_hashes]
    if not flags:
        voice("No open flags on the tape. Every catch already has "
              "an outcome.")
        return EXIT_OK
    pkg = _pkg_node_dir()
    lookup = {}
    try:
        with open(os.path.join(pkg, "lookup.json")) as f:
            lookup = json.load(f).get("lookup", {}).get("robinhood", {})
    except (OSError, ValueError):
        lookup = {}
    queue = {}
    try:
        with open(os.path.join(ndir, "queue-robinhood.jsonl")) as f:
            for line in f:
                if line.strip():
                    try:
                        q = json.loads(line)
                        queue.setdefault(q.get("block"), []).append(q)
                    except ValueError:
                        pass
    except OSError:
        queue = {}
    verdicts = {}
    try:
        with open(os.path.join(ndir, "verdicts-robinhood.jsonl")) as f:
            for line in f:
                if not line.strip():
                    continue
                try:
                    r = json.loads(line)
                    verdicts[r.get("block")] = r
                except ValueError:
                    pass
    except OSError:
        verdicts = {}
    done = 0
    for flag in flags:
        block = flag.get("block")
        rec = verdicts.get(block) or {}
        findings = rec.get("findings") or []
        outcomes = []
        for f in findings:
            check = f.get("check", "")
            if check.startswith("C1"):
                agent_ids = [q.get("agentId")
                             for q in queue.get(block, [])
                             if q.get("agentId") is not None]
                if agent_ids:
                    grades = ["#%d: %s" % (a, lookup.get(str(a),
                                                          "not in census"))
                              for a in agent_ids]
                    outcomes.append(
                        "C1 registry touch: %s" % "; ".join(grades))
                else:
                    outcomes.append("C1 registry touch: no queue "
                                    "entry for block %s — the receipt "
                                    "read has not landed yet" % block)
            elif check.startswith("C4"):
                sender = (f.get("evidence") or {}).get("sender")
                if sender:
                    counts = []
                    for b in range(block + 1, block + 11):
                        try:
                            res = _node_rpc({
                                "jsonrpc": "2.0", "id": 1,
                                "method": "eth_getBlockByNumber",
                                "params": [hex(b), True]})
                            txs = ((res or {}).get("result") or {}
                                   ).get("transactions") or []
                            n = sum(1 for t in txs
                                    if (t.get("from") or "").lower()
                                    == sender.lower())
                            counts.append(n)
                        except Exception:  # noqa: BLE001
                            counts.append(None)
                    total = sum(c or 0 for c in counts)
                    outcomes.append(
                        "C4 sender flood: %s sent %d txs across the "
                        "next 10 blocks (%s) — %s" % (
                            sender, total,
                            ", ".join(str(c) if c is not None else "?"
                                      for c in counts),
                            "the flood stopped" if total <= 20
                            else "the flood continued"))
                else:
                    outcomes.append("C4 sender flood: no sender in "
                                    "the finding — nothing to follow")
            elif check.startswith("C3"):
                source = (f.get("evidence") or {}).get("source")
                outcomes.append(
                    "C3 flagged address: source cited (%s) — the "
                    "flag stands unless the source retracts; the "
                    "node does not re-litigate a third-party list "
                    "from the terminal." % (source or "none"))
        outcome = " | ".join(outcomes) if outcomes else "no findings"
        tape.tape_outcome(ndir, flag.get("entry_hash"), outcome,
                          "resolved from the verdict record + live "
                          "reads, block %s" % block)
        done += 1
    voice("Resolved %d open flag%s on the tape — the outcomes are "
          "appended, the flags are untouched. A flag is never "
          "edited; only the follow-up is added." % (
              done, "s" if done != 1 else ""))
    return EXIT_OK


def _node_drain(argv):
    """`mad node drain [--list]`: run the queue worker against the
    node's own queue (queue-robinhood.jsonl in the node dir) — the
    Robinhood registry births the hot path enqueued. --list just
    shows the queue without grading it. The worker prints one line
    per item plus a JSON summary as its last line; this command
    voices the counts from that summary. The live grader's queue
    (~/workspace/mad-block-grader/queue-robinhood.jsonl) is never
    touched — the worker refuses to run against it."""
    flags, pos = parse_flags(argv, {"list": "bool"})
    if pos:
        raise UsageError(
            "`mad node drain` takes flags, not arguments. "
            "`mad node drain` grades the node's pending queue items; "
            "--list just shows them.")
    pkg = _pkg_node_dir()
    if not pkg or not os.path.isfile(
            os.path.join(pkg, "queue_worker.py")):
        voice("The queue worker isn't in this install. Reinstall "
              "mad-terminal 0.1.7 - queue_worker.py ships inside it.")
        return EXIT_TRANSPORT
    env = dict(os.environ)
    env["MAD_NODE_DIR"] = _node_dir()
    mode = "--list" if flags.get("list") else "--drain"
    proc = subprocess.run(
        [sys.executable, os.path.join(pkg, "queue_worker.py"), mode],
        cwd=_node_dir(), capture_output=True, text=True, env=env,
        timeout=300)
    print(proc.stdout, end="")
    if proc.stderr:
        print(proc.stderr, end="", file=sys.stderr)
    if mode == "--drain" and proc.returncode == 0:
        summary = None
        for line in reversed(proc.stdout.splitlines()):
            line = line.strip()
            if line.startswith("{"):
                try:
                    summary = json.loads(line)
                except ValueError:
                    pass
                break
        if summary:
            voice("Queue drained: %(drained)s graded, %(done)s done, "
                  "%(retried)s still pending, %(signed)s signed with "
                  "the operator key. The follow-ups are in "
                  "followups-robinhood.jsonl — and `mad node tape "
                  "--resolve` can read the newborns' grades now."
                  % summary)
    return proc.returncode


