def _closest(word, options):
    """Closest real word to a typo, or None. A word that starts with a
    real command counts: `versioncurl` is `version` with something
    stuck to it, and the human meant version."""
    for opt in options:
        if word.startswith(opt) and len(word) > len(opt):
            return opt
    matches = difflib.get_close_matches(word, options, n=1, cutoff=0.6)
    return matches[0] if matches else None


def _meta_flag(argv):
    """A -h/--help/-v/--version hiding anywhere in the line. Returns
    'help', 'version', or None. Humans type `mad test --help` - the
    flag has to work there, not only before the command."""
    for i, a in enumerate(argv):
        if a in ("-h", "--help"):
            if i and argv[i - 1] in VALUE_FLAGS:
                continue
            return "help"
        if a in ("-v", "--version"):
            if i and argv[i - 1] in VALUE_FLAGS:
                continue
            return "version"
    return None


# ---------------------------------------------------------------- HTTP

def _b64_decode_json(s):
    import base64
    raw = base64.b64decode("".join(str(s).split()))
    return json.loads(raw.decode("utf-8"))


def api(method, path, body=None, payment=None, timeout=30):
    """One call to the Mad Check API.

    Returns the parsed JSON body. Raises PaymentRequired on 402 (with
    the decoded requirements), ApiError on other HTTP errors, and
    TransportError when the line is dead. A transport failure is never
    a verdict: a truncated read or a dead line is retried once, then
    reported cleanly - never a traceback, never a grade.
    """
    url = API + path
    data = None
    headers = {"User-Agent": USER_AGENT, "Accept": "application/json",
               # gzip: the Worker answers ~10x smaller, and a smaller
               # body survives the edge's habit of closing HTTP/1.1
               # connections a few bytes short of the end.
               "Accept-Encoding": "gzip"}
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    if payment:
        # A payload YOU signed elsewhere. mad never signs.
        headers["PAYMENT-SIGNATURE"] = payment
    last_transport = None
    for attempt in range(3):
        req = urllib.request.Request(url, data=data, headers=headers,
                                     method=method)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                raw = r.read()
                if r.headers.get("Content-Encoding") == "gzip":
                    raw = gzip.decompress(raw)
                raw = raw.decode("utf-8")
            try:
                return json.loads(raw)
            except ValueError:
                raise TransportError(
                    "the door answered something that isn't JSON "
                    "(%d bytes). That's a broken line, not a verdict."
                    % len(raw))
        except urllib.error.HTTPError as e:
            raw = e.read().decode("utf-8", "replace")
            if e.code == 402:
                facts = {}
                err = None
                for h in ("Payment-Required", "X-PAYMENT-REQUIRED"):
                    v = e.headers.get(h)
                    if v:
                        try:
                            decoded = _b64_decode_json(v)
                            acc = decoded.get("accepts") or []
                            if acc:
                                facts = acc[0]
                            err = decoded.get("error")
                            break
                        except Exception:
                            pass
                if not facts:
                    try:
                        facts = json.loads(raw).get("accepts", [{}])[0]
                    except Exception:
                        facts = {}
                raise PaymentRequired(facts, err)
            raise ApiError(e.code, raw)
        except (urllib.error.URLError, http.client.HTTPException,
                ConnectionError, TimeoutError) as e:
            last_transport = e
            if attempt < 2:
                time.sleep(0.5 * (attempt + 1))
                continue
            raise TransportError(
                "the line died mid-answer (%s). Retried twice, still "
                "dead. That's a network failure, not a verdict."
                % (getattr(e, "reason", None) or e))
    raise TransportError("the line died (%s)." % last_transport)


