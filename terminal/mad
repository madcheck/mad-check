def _node_start(argv):
    flags, pos = parse_flags(
        argv, {"owner": "bool", "wallet": "value",
               "payment-tx": "value", "test": "bool"})
    if pos:
        raise UsageError(
            "`mad node start` takes flags, not arguments. --wallet "
            "0x... names the operator, --owner runs MAD's own node, "
            "--test is the same free path. No license, no payment.")
    pkg = _pkg_node_dir()
    if not pkg:
        voice("The node files aren't in this install. Reinstall "
              "mad-terminal 0.1.6 - the node ships inside it.")
        return EXIT_TRANSPORT
    ndir = _node_dir()
    pid = _node_stay_pid()
    if _node_alive(pid):
        voice("The node is already running (supervisor pid %d). "
              "`mad node status` shows what it's grading." % pid)
        return EXIT_OK
    # A 0.1.5 grader running without a supervisor is adopted by the
    # supervisor below — never double-started.
    wallet = (flags.get("wallet") or "").lower()
    owner = bool(flags.get("owner"))
    test = bool(flags.get("test"))
    if not owner and not test and not wallet:
        try:
            with open(os.path.join(ndir, "license.json")) as f:
                wallet = json.load(f).get("wallet", "").lower()
        except (OSError, ValueError):
            wallet = ""
    if wallet and wallet == NODE_MAD_WALLET:
        owner = True
    if owner:
        # The operator wallet is the toll destination: the serve
        # door's payTo reads license.json, so owner mode records
        # MAD's wallet here — otherwise the paid door has nobody
        # to pay and stays closed.
        wallet = NODE_MAD_WALLET
    # Free to run - no license, no monthly fee (founder order
    # 2026-11-24). --test is the same free path as every start
    # now; --payment-tx is accepted and ignored, a leftover from
    # the retired $15 license. No chain scan, no payment check.
    if test and not owner:
        voice("TEST MODE - the same free path as every node now. "
              "The node grades for evaluation; it runs free.")
    elif owner:
        voice("Owner mode - MAD's own node. Free, like every node.")
    else:
        voice("Free to run - no license, no monthly fee. The node "
              "grades Robinhood live.")
    with open(os.path.join(ndir, "license.json"), "w") as f:
        json.dump({"wallet": wallet or ("test" if test else "free"),
                   "paid": True, "free": True, "owner": owner,
                   "test": test, "found_usdg": None,
                   "checked_at": int(time.time())}, f)
    # 0.1.6: start the staying-alive kit, not the grader directly.
    # The supervisor (node_stay.py) starts the grader AND the serve
    # door, restarts either on exit, and writes the heartbeat +
    # status another agent can check. The grader is never a bare
    # detached process again.
    if not os.path.isfile(os.path.join(pkg, "node_stay.py")):
        voice("The staying-alive kit isn't in this install. "
              "Reinstall mad-terminal 0.1.6 - node_stay.py ships "
              "inside it.")
        return EXIT_TRANSPORT
    sup_pid = _node_start_supervisor(pkg)
    time.sleep(3)
    if not _node_alive(sup_pid):
        voice("The supervisor died on start. Last of the log:")
        try:
            with open(os.path.join(ndir, "node-stay.log"), "rb") as f:
                tail = f.read()[-2000:].decode(errors="replace")
            print(tail)
        except OSError:
            pass
        return EXIT_API_ERROR
    grader_pid = None
    for _ in range(9):
        st = _node_stay_status()
        if st and st.get("grader", {}).get("alive"):
            grader_pid = st["grader"]["pid"]
            break
        time.sleep(1)
    serve_cfg = {"port": 8403, "host": "127.0.0.1"}
    try:
        with open(os.path.join(ndir, "node-config.json")) as f:
            serve_cfg.update(json.load(f))
    except (OSError, ValueError):
        pass
    voice("Node running (supervisor pid %d%s). Grading Robinhood "
          "live - `mad tail` shows the verdicts as they land. The "
          "A2A door is on http://%s:%d — status free, verdict line "
          "free, full verdict 1c." % (
              sup_pid,
              ", grader pid %d" % grader_pid if grader_pid else "",
              serve_cfg.get("host", "127.0.0.1"),
              serve_cfg.get("port", 8403)))
    return EXIT_OK


def _node_stop(argv):
    flags, pos = parse_flags(argv, {})
    if pos:
        raise UsageError("`mad node stop` takes no arguments.")
    st = _node_stay_status()
    pids = []  # children first, supervisor last
    if st:
        for key in ("grader", "serve"):
            p = (st.get(key) or {}).get("pid")
            if p:
                pids.append(p)
        if st.get("supervisor_pid"):
            pids.append(st["supervisor_pid"])
    sup = _node_stay_pid()
    if sup and sup not in pids:
        pids.append(sup)
    legacy = _node_pid()
    if legacy and legacy not in pids:
        pids.append(legacy)
    live = [p for p in pids if _node_alive(p)]
    if not live:
        voice("The node isn't running. Nothing to stop.")
        return EXIT_OK
    for p in live:
        try:
            os.kill(p, signal.SIGTERM)
        except OSError:
            pass
    for _ in range(10):
        time.sleep(0.5)
        live = [p for p in pids if _node_alive(p)]
        if not live:
            break
    for p in live:
        try:
            os.kill(p, signal.SIGKILL)
        except OSError:
            pass
    for name in ("node.pid", "node-stay.pid"):
        try:
            os.remove(os.path.join(_node_dir(), name))
        except OSError:
            pass
    voice("Node stopped (was supervisor pid %s). The ledger stays - "
          "`mad node start` resumes where it left off." % (sup or "?"))
    return EXIT_OK


