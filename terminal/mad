def _node_tasks_base():
    """Where the MAD TASKS board lives. Env override, else the local
    canonical API if it answers, else the public mirror."""
    if os.environ.get("MAD_TASKS_API"):
        return os.environ["MAD_TASKS_API"].rstrip("/")
    try:
        with urllib.request.urlopen(
                "http://127.0.0.1:8402/v1/health", timeout=3) as r:
            if r.status == 200:
                return "http://127.0.0.1:8402"
    except Exception:  # noqa: BLE001 - the mirror is the fallback
        pass
    return API


def _tasks_http(method, path, body=None, timeout=30):
    """JSON client for the board. Returns the parsed envelope."""
    base = _node_tasks_base()
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        base + path, data=data, method=method,
        headers={"Content-Type": "application/json",
                 "Accept": "application/json", "User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        raise ApiError(e.code, e.read().decode("utf-8", "replace"))
    except (urllib.error.URLError, TimeoutError) as e:
        raise TransportError("tasks board unreachable at %s: %s"
                             % (base, e))


def _node_operator_identity():
    """The worker identity the node takes and delivers tasks as:
    node-config.json operator block, else the license wallet, else
    the bare node name. The board needs a name; the rest is proof."""
    ident = {"name": "MAD Node"}
    try:
        with open(os.path.join(_node_dir(), "node-config.json")) as f:
            op = json.load(f).get("operator") or {}
        for key in ("name", "agentId", "chainId", "wallet", "handle",
                    "contact"):
            if op.get(key) is not None:
                ident[key] = op[key]
    except (OSError, ValueError):
        pass
    if "wallet" not in ident:
        try:
            with open(os.path.join(_node_dir(), "license.json")) as f:
                wallet = json.load(f).get("wallet", "")
            if wallet and wallet.startswith("0x"):
                ident["wallet"] = wallet
        except (OSError, ValueError):
            pass
    if ident.get("wallet", "").lower() == NODE_MAD_WALLET:
        ident.setdefault("agentId", 26409)
        ident.setdefault("chainId", 4663)
    return ident


def _node_task_target(title, description):
    """What the task asks to be graded: a tx (64 hex), a contract
    (40 hex), or an agent id. The target is read BEFORE the node
    takes the job — it never takes work it can't parse."""
    text = "%s\n%s" % (title or "", description or "")
    m = re.search(r"0x[0-9a-fA-F]{64}", text)
    if m:
        return "tx", m.group(0)
    m = re.search(r"0x[0-9a-fA-F]{40}", text)
    if m:
        return "contract", m.group(0)
    m = re.search(r"agent[ -]?id\s*[:#]?\s*(\d+)", text, re.I)
    if m:
        return "agent", int(m.group(1))
    m = re.search(r"\b(\d{4,})\b", text)
    if m:
        return "agent", int(m.group(1))
    return None, None


def _node_grade_agent_local(agent_id):
    """Grade an agent from the node's own census + a live registry
    read. Returns (verdict, evidence, links). No API, no trust —
    the census is a snapshot, the ownerOf call is live."""
    pkg = _pkg_node_dir()
    census = None
    try:
        with open(os.path.join(pkg, "lookup.json")) as f:
            look = json.load(f).get("lookup", {})
        census = (look.get("robinhood") or {}).get(str(agent_id))
    except (OSError, ValueError):
        census = None
    owner = None
    rpc_error = None
    try:
        payload = {"jsonrpc": "2.0", "id": 1, "method": "eth_call",
                   "params": [{"to": NODE_RH_REGISTRY,
                               "data": "0x6352211e"
                                       + format(agent_id, "064x")},
                              "latest"]}
        res = _node_rpc(payload)
        data = (res or {}).get("result")
        if isinstance(data, str) and data.startswith("0x") \
                and len(data) >= 42 and int(data[-40:], 16) != 0:
            owner = "0x" + data[-40:]
        elif (res or {}).get("error"):
            rpc_error = str((res or {}).get("error"))
    except Exception as e:  # noqa: BLE001 - transport is never a verdict
        rpc_error = str(e)
    name = None
    try:
        with open(os.path.join(pkg,
                               "known_agents_robinhood.json")) as f:
            for a in json.load(f).get("agents", []):
                if a.get("agentId") == agent_id:
                    name = a.get("name")
    except (OSError, ValueError):
        pass
    who = "%s #%d" % (name, agent_id) if name else "agent #%d" % agent_id
    if census == "LIVE" and owner:
        verdict = "PASS"
        why = ("%s reads LIVE in the census and the registry "
               "ownerOf(%d) returns %s live — the identity is real "
               "and live." % (who, agent_id, owner))
    elif census == "LIVE" and rpc_error:
        verdict = "PASS"
        why = ("%s reads LIVE in the census; the live registry read "
               "failed (%s) — transport, not a verdict — so the "
               "grade stands on the census." % (who, rpc_error))
    elif census == "LIVE":
        verdict = "INCONCLUSIVE"
        why = ("%s reads LIVE in the census but the registry has no "
               "owner for #%d — the census is stale or the identity "
               "moved. Re-grade after the next census." % (who, agent_id))
    elif census in ("DEAD END", "GHOST", "MALFORMED"):
        verdict = census
        why = ("%s reads %s in the census of 26,308 Robinhood "
               "agents — the grade is the census grade, and the "
               "live registry read %s." % (
                   who, census,
                   ("confirms an owner %s" % owner) if owner
                   else ("finds no owner" if not rpc_error
                         else "failed (%s)" % rpc_error)))
    elif owner:
        verdict = "INCONCLUSIVE"
        why = ("%s is NOT in the census but the registry ownerOf(%d) "
               "returns %s live — registered, ungraded. The census "
               "is a snapshot; this one landed after it." % (
                   who, agent_id, owner))
    else:
        verdict = "GHOST"
        why = ("%s is not in the census and the registry has no "
               "owner for #%d%s — no identity, no grade to give." % (
                   who, agent_id,
                   (" (live read failed: %s)" % rpc_error)
                   if rpc_error else ""))
    evidence = ("Grade: %s. How: census lookup in the node's "
                "100,000-agent population + live ownerOf(%d) on the "
                "ERC-8004 registry %s. Why: %s Standard: a live "
                "agent has a census LIVE and a live registry owner; "
                "anything else is the census grade or INCONCLUSIVE, "
                "never a guess." % (
                    verdict, agent_id, NODE_RH_REGISTRY, why))
    links = ["https://madcheck.xyz/node"]
    return verdict, evidence, links


def _node_grade_contract_local(address):
    """Grade a contract: code exists? Is it a known agent's wallet?
    Anything else is INCONCLUSIVE — code is not identity."""
    pkg = _pkg_node_dir()
    code = None
    rpc_error = None
    try:
        res = _node_rpc({"jsonrpc": "2.0", "id": 1,
                         "method": "eth_getCode",
                         "params": [address, "latest"]})
        code = (res or {}).get("result")
    except Exception as e:  # noqa: BLE001
        rpc_error = str(e)
    agent_id = None
    name = None
    try:
        with open(os.path.join(pkg,
                               "known_agents_robinhood.json")) as f:
            for a in json.load(f).get("agents", []):
                if (a.get("wallet") or "").lower() == address.lower():
                    agent_id = a.get("agentId")
                    name = a.get("name")
    except (OSError, ValueError):
        pass
    if agent_id is not None:
        verdict, evidence, links = _node_grade_agent_local(agent_id)
        evidence = ("Contract %s is the wallet of %s #%d. %s" % (
            address, name or "agent", agent_id, evidence))
        return verdict, evidence, links
    if code == "0x":
        verdict = "GHOST"
        why = ("No code at %s — nothing deployed there, nothing "
               "to grade." % address)
    elif code:
        verdict = "INCONCLUSIVE"
        why = ("Code exists at %s (%d bytes) but the address "
               "matches no known agent wallet and no registry "
               "identity — code is not identity, so this is not "
               "a grade, it's a fact." % (address, (len(code) - 2) // 2))
    else:
        verdict = "INCONCLUSIVE"
        why = ("The code read failed (%s) — transport, not a "
               "verdict." % (rpc_error or "empty response"))
    evidence = ("Grade: %s. How: eth_getCode on Robinhood + the "
                "known-agent wallet map. Why: %s Standard: a "
                "contract is graded by its identity, not its "
                "bytecode." % (verdict, why))
    return verdict, evidence, ["https://madcheck.xyz/node"]


def _node_task_take(task_id):
    """take → grade on demand → deliver. The delivery is the grade;
    MAD's grade of the delivery is the parent's step, not the
    node's — the node reports what it delivered."""
    board = _tasks_http("GET", "/v1/tasks")
    records = board.get("records") or []
    open_tasks = [t for t in records if t.get("status") == "open"]
    open_tasks.sort(key=lambda t: float(t.get("price") or 0),
                    reverse=True)
    if task_id:
        task = next((t for t in open_tasks
                     if t.get("task_id") == task_id), None)
        if not task:
            known = next((t for t in records
                          if t.get("task_id") == task_id), None)
            if known:
                voice("Task %s is %s, not open — nothing to take."
                      % (task_id, known.get("status")))
            else:
                voice("No task %s on the board." % task_id)
            return EXIT_API_ERROR
    else:
        if not open_tasks:
            voice("No open tasks on the board. The node is idle — "
                  "the board is the work, and the board is empty.")
            return EXIT_OK
        task = open_tasks[0]
        task_id = task["task_id"]
    kind, target = _node_task_target(task.get("title"),
                                     task.get("description"))
    if not kind:
        voice("Task %s has no gradeable target — no tx, no contract, "
              "no agent id in the title or description. Not taken; "
              "a node takes work it can grade." % task_id)
        return EXIT_API_ERROR
    ident = _node_operator_identity()
    taken = _tasks_http("POST", "/v1/tasks/%s/take" % task_id,
                        {"worker": ident})
    if taken.get("status") != "taken":
        voice("The board would not hand over %s: %s"
              % (task_id, taken.get("status")))
        return EXIT_API_ERROR
    voice("Took %s (%s, %s %s) — grading now." % (
        task_id, task.get("title"), kind, target))
    ndir = _node_dir()
    verdict = None
    evidence = None
    links = []
    vhash = None
    if kind == "tx":
        pkg = _pkg_node_dir()
        env = dict(os.environ)
        env["MAD_NODE_DIR"] = ndir
        proc = subprocess.run(
            [sys.executable, os.path.join(pkg, "node_task.py"),
             "--tx", target],
            cwd=ndir, capture_output=True, text=True, env=env)
        if proc.stdout:
            print(proc.stdout, end="")
        if proc.returncode != 0:
            if proc.stderr:
                print(proc.stderr, end="")
            return EXIT_API_ERROR
        last = _last_jsonl(os.path.join(ndir,
                                        "task-grades-robinhood.jsonl"))
        if not last:
            voice("The task grader ran but wrote no record — "
                  "nothing to deliver.")
            return EXIT_API_ERROR
        verdict = last.get("verdict")
        evidence = ("Grade: %s. How: %s Why: %s Standard: %s" % (
            verdict,
            "; ".join("%s: %s" % (c.get("check"), c.get("detail"))
                      for c in last.get("how", [])),
            last.get("why"), last.get("standard")))
        links = ["https://madcheck.xyz/node"]
    elif kind == "agent":
        verdict, evidence, links = _node_grade_agent_local(target)
    else:
        verdict, evidence, links = _node_grade_contract_local(target)
    evidence = evidence[:3800]
    _sign, tape = _node_modules()
    if _sign is not None and tape is not None:
        try:
            key = _sign.load_operator_key()
            if key:
                vhash = tape.verdict_hash(
                    {"verdict": verdict, "task_id": task_id,
                     "target": "%s:%s" % (kind, target),
                     "evidence": evidence})
        except Exception:  # noqa: BLE001
            vhash = None
    if vhash:
        links.append("verdict_hash:%s" % vhash)
    delivered = _tasks_http(
        "POST", "/v1/tasks/%s/deliver" % task_id,
        {"worker": ident, "evidence": evidence, "links": links})
    if delivered.get("status") != "delivered":
        voice("Delivered, but the board says %s — read it back "
              "before trusting it." % delivered.get("status"))
        return EXIT_API_ERROR
    if tape is not None:
        try:
            tape.tape_task(ndir, task_id, "%s:%s" % (kind, target),
                            verdict, vhash)
        except Exception:  # noqa: BLE001 - the tape never blocks delivery
            pass
    voice("Delivered %s: %s. The grade is on the board; MAD's grade "
          "of the delivery is next, and it is not mine to give."
          % (task_id, verdict))
    return EXIT_OK


def _node_serve(argv):
    flags, pos = parse_flags(argv, {
        "port": "value", "host": "value", "foreground": "bool"})
    if pos:
        raise UsageError("`mad node serve` takes flags, not arguments.")
    ndir = _node_dir()
    cfg_path = os.path.join(ndir, "node-config.json")
    cfg = {}
    try:
        with open(cfg_path) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    port = int(flags.get("port") or cfg.get("port") or 8403)
    host = flags.get("host") or cfg.get("host") or "127.0.0.1"
    cfg["port"] = port
    cfg["host"] = host
    with open(cfg_path, "w") as f:
        json.dump(cfg, f, indent=2)
    pkg = _pkg_node_dir()
    if not pkg or not os.path.isfile(os.path.join(pkg, "node_serve.py")):
        voice("The serve door isn't in this install. Reinstall "
              "mad-terminal 0.1.6 - node_serve.py ships inside it.")
        return EXIT_TRANSPORT
    if flags.get("foreground"):
        # The supervisor is the normal path; --foreground is the
        # debug door, one process, no restart.
        proc = subprocess.run(
            [sys.executable, os.path.join(pkg, "node_serve.py"),
             "--port", str(port), "--host", host], cwd=ndir)
        return proc.returncode or EXIT_OK
    if not _node_alive(_node_stay_pid()):
        _node_start_supervisor(pkg)
        time.sleep(3)
    url = "http://%s:%d" % (host, port)
    voice("The A2A door is on %s — status free, verdict line free, "
          "full verdict 1c via x402, tape free. Another agent reads "
          "what this node sees and pays per verdict, not per "
          "month." % url)
    print("  %s/v1/node/status   — free: is it alive, is it at the tip"
          % url)
    print("  %s/v1/node/verdicts?block=N   — free line, &full=1 is 1c"
          % url)
    print("  %s/v1/node/agent/<id>   — free summary, &full=1 is 1c"
          % url)
    print("  %s/v1/node/tape   — free: the public tape, chain checked"
          % url)
    print("  %s/v1/node/verify?block=N   — free: re-verify a verdict"
          % url)
    return EXIT_OK


