MCP_TOOLS = ["mad_test", "mad_check_agent", "mad_check_authorization",
             "mad_check_endpoint", "mad_seal_lookup", "mad_witness_head",
             "mad_complaints"]


def cmd_mcp(argv):
    flags, pos = parse_flags(argv, {"ping": "bool", "json": "bool"})
    if pos:
        raise UsageError(
            "`mad mcp` takes no arguments. `--ping` checks the door "
            "live, that's the only extra.")
    if flags.get("ping"):
        init = {"jsonrpc": "2.0", "id": 1, "method": "initialize",
                "params": {"protocolVersion": "2024-11-05",
                           "capabilities": {},
                           "clientInfo": {"name": "mad-terminal",
                                          "version": VERSION}}}
        data = api("POST", "/mcp", init)
        # tools/list is a second JSON-RPC call on the same door. It
        # rides the same retrying transport as every other call -
        # the edge truncates long HTTP/1.1 bodies, so this goes
        # through the same gzip + retry loop instead of a bare read.
        raw = None
        last_err = None
        for attempt in range(3):
            req = urllib.request.Request(
                API + "/mcp",
                data=json.dumps({"jsonrpc": "2.0", "id": 2,
                                 "method": "tools/list",
                                 "params": {}}).encode("utf-8"),
                headers={"Content-Type": "application/json",
                         "Accept": "application/json, text/event-stream",
                         "Accept-Encoding": "gzip",
                         "User-Agent": USER_AGENT,
                         "Mcp-Session-Id": data.get("sessionId", "")},
                method="POST")
            try:
                with urllib.request.urlopen(req, timeout=30) as r:
                    chunk = r.read()
                    if r.headers.get("Content-Encoding") == "gzip":
                        chunk = gzip.decompress(chunk)
                    raw = chunk.decode("utf-8", "replace")
                break
            except urllib.error.HTTPError as e:
                raw = e.read().decode("utf-8", "replace")
                break
            except (urllib.error.URLError, http.client.HTTPException,
                    ConnectionError, TimeoutError) as e:
                last_err = e
                if attempt < 2:
                    time.sleep(0.5 * (attempt + 1))
        if raw is None:
            raise TransportError(
                "the MCP door died mid-answer (%s). Retried twice. "
                "That's the line, not the door." % last_err)
        tools = []
        try:
            tools = json.loads(raw).get("result", {}).get("tools", [])
        except ValueError:
            for line in raw.splitlines():
                if line.startswith("data:"):
                    try:
                        tools = json.loads(line[5:]).get(
                            "result", {}).get("tools", [])
                    except Exception:
                        pass
        names = [t.get("name") for t in tools] or MCP_TOOLS
        voice("The MCP door answers. %d tools live: %s. Free, no key, "
              "no account - the REST verdict doors are the ones that "
              "cost a cent." % (len(names), ", ".join(names)))
        show({"endpoint": API + "/mcp", "transport": "streamable-http",
              "tools": names})
        return EXIT_OK
    voice("Give your agent my server and it can grade before it signs. "
          "Paste one of these blocks - Claude, Codex, or Grok - and "
          "the seven tools ride along. Free, no key, no account.")
    print()
    print("  # Claude Code - .mcp.json")
    print(json.dumps(
        {"mcpServers": {"mad-check": {"type": "http",
                                      "url": API + "/mcp"}}}, indent=2))
    print()
    print("  # Codex - config.toml")
    print("  [mcp_servers.mad-check]")
    print("  url = \"%s\"" % (API + "/mcp"))
    print()
    print("  # Grok - MCP server (streamable HTTP)")
    print(json.dumps(
        {"name": "mad-check", "type": "mcp", "server_url": API + "/mcp",
         "transport": "streamable-http"}, indent=2))
    print()
    print("  Tools: %s" % ", ".join(MCP_TOOLS))
    print("  Check it live: mad mcp --ping")
    return EXIT_OK


