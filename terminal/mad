def _node_license(argv):
    """The node is free - no license, no monthly fee, no chain scan
    (founder order 2026-11-24). `--wallet 0x...` also RECORDS the
    operator wallet in license.json: the wallet is only the toll
    destination for the serve door's payTo, never a license."""
    flags, pos = parse_flags(argv, {"wallet": "value",
                                    "payment-tx": "value"})
    wallet = (flags.get("wallet") or "").lower()
    if pos and not wallet:
        wallet = pos[0].lower()
    if pos and wallet and pos[0].lower() != wallet:
        raise UsageError(
            "`mad node license` takes one wallet: --wallet 0x... .")
    if wallet:
        if not (wallet.startswith("0x") and len(wallet) == 42):
            raise UsageError(
                "That's not a wallet. 0x + 40 hex characters.")
        lic_path = os.path.join(_node_dir(), "license.json")
        try:
            with open(lic_path) as f:
                old = json.load(f)
        except (OSError, ValueError):
            old = {}
        with open(lic_path, "w") as f:
            json.dump({"wallet": wallet, "paid": True, "free": True,
                       "owner": wallet == NODE_MAD_WALLET,
                       "test": bool(old.get("test")),
                       "found_usdg": None,
                       "checked_at": int(time.time())}, f)
        voice("Operator wallet recorded: %s. The serve door's paid "
              "verdicts now pay there — the license is still free, "
              "the wallet is only the toll destination." % wallet)
    if not wallet:
        try:
            with open(os.path.join(_node_dir(), "license.json")) as f:
                wallet = json.load(f).get("wallet", "").lower()
        except (OSError, ValueError):
            wallet = ""
    lic = _node_license_free(wallet)
    voice("The node is FREE - no license, no monthly fee. $15/mo "
          "was too much, so the license is gone. Run it: "
          "`mad node start`.")
    show(lic)
    return EXIT_OK


def _node_task(argv):
    # Bare `--take` takes the highest-priced open task; `--take
    # TSK-0002` takes that one. parse_flags wants a value, so a
    # bare --take is rewritten before parsing.
    argv = list(argv)
    for i, a in enumerate(argv):
        if a == "--take" and (i + 1 >= len(argv)
                              or argv[i + 1].startswith("--")):
            argv[i] = "--take=highest"
    flags, pos = parse_flags(argv, {"take": "value"})
    if flags.get("take"):
        task_id = flags["take"]
        return _node_task_take(
            None if task_id == "highest" else task_id)
    if not pos or len(pos) != 1:
        raise UsageError(
            "`mad node task` grades one task: `mad node task 0x...` - "
            "one transaction hash on Robinhood — or `mad node task "
            "--take [TSK-0002]` to take a job off the board.")
    tx = pos[0]
    if not (tx.startswith("0x") and len(tx) == 66):
        raise UsageError(
            "That's not a transaction hash. 0x + 64 hex characters, "
            "on Robinhood.")
    pkg = _pkg_node_dir()
    if not pkg:
        voice("The node files aren't in this install. Reinstall "
              "mad-terminal 0.1.6 - the node ships inside it.")
        return EXIT_TRANSPORT
    env = dict(os.environ)
    env["MAD_NODE_DIR"] = _node_dir()
    proc = subprocess.run(
        [sys.executable, os.path.join(pkg, "node_task.py"),
         "--tx", tx],
        cwd=_node_dir(), capture_output=True, text=True, env=env,
        timeout=120)
    print(proc.stdout, end="")
    if proc.stderr:
        print(proc.stderr, end="", file=sys.stderr)
    return proc.returncode


